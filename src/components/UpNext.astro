---
import TeamMark from "./TeamMark.astro";
import { gameCalendar, gameDayView } from "../lib/game-day.mjs";

const { game, canonicalBase, now = new Date(), isNextGame = true } = Astro.props;
const view = gameDayView(game, now);
const calendar = gameCalendar(game, canonicalBase);
---

{view && <section class:list={["up-next", `state-${game.state}`]} id={isNextGame ? "next-game" : "latest-game"} aria-labelledby="up-next-matchup">
  <div class="feature-bar">
    <div><span class="status">{view.status}</span><span class="week">{view.phaseWeek}</span></div>
    <div class="badges">{view.division && <span>Division</span>}{view.primeTime && <span>Prime time</span>}</div>
  </div>

  <div class="feature-grid">
    <div class="matchup">
      <div class="team">
        <TeamMark abbreviation={view.seaAbbr} name={view.seaName} size={64} decorative loading="eager" />
        <div><span>{view.seaName.split(" ").slice(0, -1).join(" ")}</span><strong>{view.seaName.split(" ").at(-1)}</strong>{view.seaRecord && <small>{view.seaRecord}</small>}</div>
      </div>
      <div class="location"><span>{view.location}</span>{view.result && <strong class={`outcome outcome-${view.result.outcome.toLowerCase()}`}>{view.result.outcome}</strong>}</div>
      <div class="team opponent">
        <TeamMark abbreviation={view.opponentAbbr} name={view.opponentName} size={64} decorative loading="eager" />
        <div><span>{view.opponentName.split(" ").slice(0, -1).join(" ")}</span><strong>{view.opponentName.split(" ").at(-1)}</strong>{view.opponentRecord && <small>{view.opponentRecord}</small>}</div>
      </div>
      <h2 id="up-next-matchup">{isNextGame ? "Next Game" : "Latest Game"}: {view.seaName} {game.isHome ? "vs." : "at"} {view.opponentName}</h2>
      {(view.result || view.liveScore) && <p class="score" aria-label={`${view.result ? "Final" : "Live"} score: ${view.seaName} ${(view.result || view.liveScore).{team}}, ${view.opponentName} ${(view.result || view.liveScore).opponent}`}><strong>{(view.result || view.liveScore).{team}}</strong><span>{view.result ? "Final" : "Live"}</span><strong>{(view.result || view.liveScore).opponent}</strong></p>}
    </div>

    <div class="utility">
      <div class="kickoff"><span>{view.date}</span><strong>{view.kickoff}</strong></div>
      <dl>
        {view.network && <div><dt>Watch</dt><dd>{view.network}</dd></div>}
        {view.radio && <div><dt>Listen</dt><dd>{view.radio}</dd></div>}
        {view.venue && <div><dt>Venue</dt><dd>{view.venueUrl ? <a href={view.venueUrl} aria-label={`Venue information for ${view.venue}`}>{view.venue}</a> : view.venue}</dd></div>}
      </dl>
      {(!view.network || !view.venue) && game.state === "tbd" && <p class="pending">Additional game details are still pending.</p>}
      <div class="actions">
        {view.primaryLabel && <a class="primary" href={view.detailHref} aria-label={`${view.primaryLabel}: ${view.seaName} ${game.isHome ? "vs." : "at"} ${view.opponentName}`}>{view.primaryLabel}</a>}
        {calendar.enabled
          ? <a class="secondary" href={calendar.href} download={calendar.filename} aria-label={`Add ${view.seaName} ${game.isHome ? "vs." : "at"} ${view.opponentName} to calendar`}>{calendar.label}</a>
          : <span class="disabled" aria-disabled="true" title={calendar.reason}>{calendar.label}</span>}
      </div>
      {!calendar.enabled && <small class="calendar-note">{calendar.reason}</small>}
    </div>
  </div>
</section>}

<style>
  .up-next{margin:.85rem 0 1rem;scroll-margin-top:1rem;border:1px solid var(--slate-300);border-top:4px solid var(--action-green);background:#fff;box-shadow:0 8px 24px #00224412;color:var(--navy-950)}
  .feature-bar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.55rem .85rem;border-bottom:1px solid var(--slate-300);background:var(--slate-100)}.feature-bar>div{display:flex;align-items:center;gap:.65rem}.status{font:900 .78rem var(--font-display);letter-spacing:.07em;text-transform:uppercase}.state-in_progress .status{color:#9b1c1c}.week{color:var(--slate-700);font-size:.72rem;font-weight:800}.badges span{padding:.18rem .4rem;background:var(--navy-800);color:#fff;font-size:.6rem;font-weight:900;letter-spacing:.04em;text-transform:uppercase}
  .feature-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(250px,.8fr)}.matchup{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:.8rem;padding:1rem 1.15rem;text-align:center}.team{display:flex;align-items:center;gap:.65rem;text-align:left}.team>div{min-width:0}.team span,.team strong,.team small{display:block}.team span{color:var(--slate-700);font-size:.72rem;font-weight:700}.team strong{font:900 1rem/1.05 var(--font-display)}.team small{margin-top:.16rem;color:var(--slate-700);font-weight:800}.opponent{flex-direction:row-reverse;text-align:right}.location{display:grid;gap:.25rem;place-items:center;color:var(--slate-700);font-size:.69rem;font-weight:900;text-transform:uppercase}.outcome{display:grid;width:1.7rem;height:1.7rem;place-items:center;background:var(--action-green);color:var(--navy-950)}.outcome-l{background:#9f2d27;color:#fff}.outcome-t{background:var(--slate-500)}h2{grid-column:1/-1;margin:.35rem 0 0;font-size:1.12rem}.score{grid-column:1/-1;display:flex;align-items:center;justify-content:center;gap:.7rem;margin:0;font-variant-numeric:tabular-nums}.score strong{font:900 1.45rem var(--font-display)}.score span{color:var(--slate-700);font-size:.65rem;font-weight:900;text-transform:uppercase}
  .utility{padding:1rem 1.1rem;border-left:1px solid var(--slate-300)}.kickoff span,.kickoff strong{display:block}.kickoff span{font-size:.8rem;font-weight:800}.kickoff strong{margin-top:.15rem;font:900 1.22rem var(--font-display)}dl{display:grid;gap:.32rem;margin:.7rem 0}dl div{display:grid;grid-template-columns:3.4rem 1fr;gap:.5rem}dt{color:var(--slate-700);font-size:.67rem;font-weight:900;text-transform:uppercase}dd{margin:0;font-size:.76rem;font-weight:800}.pending,.calendar-note{display:block;margin:.45rem 0;color:var(--slate-700);font-size:.68rem}.actions{display:flex;gap:.45rem;margin-top:.7rem}.actions a,.disabled{display:inline-flex;min-height:40px;align-items:center;justify-content:center;padding:.45rem .7rem;border:2px solid var(--navy-800);font-size:.72rem;font-weight:900;text-decoration:none}.primary{background:var(--navy-800);color:#fff}.secondary{background:#fff;color:var(--navy-900)}.actions a:hover,.actions a:focus-visible{outline:3px solid var(--action-green);outline-offset:2px}.disabled{border-color:var(--slate-300);color:var(--slate-700);cursor:not-allowed}
  @media(max-width:760px){.feature-grid{grid-template-columns:1fr}.utility{border-top:1px solid var(--slate-300);border-left:0}.matchup{padding:.9rem}.team{flex-direction:column;text-align:center}.opponent{flex-direction:column}.actions{display:grid;grid-template-columns:1fr}.actions a,.disabled{width:100%;box-sizing:border-box}}
  @media(max-width:420px){.feature-bar{align-items:flex-start}.feature-bar>div:first-child{align-items:flex-start;flex-direction:column;gap:.15rem}.matchup{gap:.4rem;padding:.8rem .55rem}.matchup :global(.team-mark){--team-mark-size:52px!important}.team strong{font-size:.83rem}.team span{font-size:.64rem}h2{font-size:1rem}}
</style>
