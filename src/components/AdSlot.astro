---
import { AD_CLIENT_ID, AD_SLOT_IDS, mayRenderAd, mayRenderAdOnMobile, type AdPageType, type AdPlacement } from "../lib/advertising";

interface Props {
  pageType: AdPageType;
  placement: AdPlacement;
  ordinal?: number;
  contentUnits?: number;
  thinContent?: boolean;
  sensitiveArea?: boolean;
  slotId?: string;
}

const { pageType, placement, ordinal = 1, contentUnits = 0, thinContent = false, sensitiveArea = false, slotId = AD_SLOT_IDS[placement] } = Astro.props;
const permitted = mayRenderAd({ pageType, placement, ordinal, contentUnits, thinContent, sensitiveArea });
const mobilePermitted = mayRenderAdOnMobile(pageType, ordinal);
const render = permitted && Boolean(slotId);
---

{render && <aside class:list={["ad-slot", `ad-slot--${placement}`, !mobilePermitted && "ad-slot--desktop-only"]} aria-label="Advertisement" data-ad-placement={placement} data-ad-ordinal={ordinal}>
  <span class="ad-slot__label">Advertisement</span>
  <ins class="adsbygoogle ad-slot__unit" style="display:block" data-ad-client={AD_CLIENT_ID} data-ad-slot={slotId} data-ad-format="auto" data-full-width-responsive="true"></ins>
</aside>}

{render && <script is:inline>
  (() => {
    let requested = false;
    const request = () => {
      if (requested) return;
      requested = true;
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    };
    const state = window.sfzPrivacy?.getState?.();
    if (state?.ready && state.advertising) request();
    else window.addEventListener('sfz:privacy-consent', (event) => {
      if (event.detail?.ready && event.detail.advertising) request();
    });
  })();
</script>}

<style>
  .ad-slot{box-sizing:border-box;display:grid;width:100%;min-height:280px;margin:2.5rem 0;padding:.65rem;align-content:start;overflow:hidden;clear:both;border:1px solid rgba(71,85,105,.35);background:#f8fafc;color:#475569}
  .ad-slot__label{display:block;margin-bottom:.45rem;font:700 .67rem/1.2 system-ui,sans-serif;letter-spacing:.1em;text-align:center;text-transform:uppercase}
  .ad-slot__unit,.ad-slot__placeholder{width:100%;min-height:250px}
  .ad-slot__placeholder{display:grid;place-items:center;border:1px dashed rgba(71,85,105,.45);font:600 .75rem system-ui,sans-serif}
  .ad-slot--desktop-rail{min-height:600px}.ad-slot--desktop-rail .ad-slot__unit,.ad-slot--desktop-rail .ad-slot__placeholder{min-height:570px}
  @media(max-width:760px){.ad-slot{margin:2rem 0}.ad-slot--desktop-rail,.ad-slot--desktop-only{display:none}}
</style>
