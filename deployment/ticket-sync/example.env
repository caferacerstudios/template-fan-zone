# Copy to /etc/sfz-ticket-finder/dev.env or prod.env, make it root-owned mode
# 0600, and replace values as approved. Never commit the resulting file.
TICKETS_ENV=development
TICKETS_FIXTURE=false
TICKETS_PROVIDERS_JSON={"ticketmaster":{"enabled":true,"mode":"event-summary","minRefreshMs":600000,"freshnessMs":1800000,"retentionMs":3600000,"timeoutMs":8000,"maxRetries":2,"rateLimitMs":250,"pageSize":50,"maxPages":5,"maxRequests":5}}
TICKETS_LOCK_STALE_MS=1800000
TICKETS_LOCK_HEARTBEAT_MS=60000
TICKETS_LOCK_STALE_ARTIFACT_LIMIT=3
# Season mode is operator-enabled only after replacing this placeholder in the
# private env file with the verified Seattle {Team} Ticketmaster attraction ID.
TICKETMASTER_DISCOVERY_MODE=season
TICKETMASTER_ATTRACTION_ID=REPLACE_WITH_OPERATOR_VERIFIED_ID

# Temporary fallback: use single-event (or omit the mode) until migration.
TICKETMASTER_EVENT_NAME="Seattle {Team} vs. New England Patriots"
TICKETMASTER_EVENT_DATE=2026-09-09
TICKETMASTER_LEGACY_EVENT_ID=0F006482E67E7496

# Host-side Compose settings. The service overrides TICKETS_OUTPUT_DIR to the
# container path /srv/ticket-data/current.
TICKET_DATA_ROOT=/var/lib/sfz-ticket-finder/dev
TICKET_SYNC_ENV_FILE=/etc/sfz-ticket-finder/dev.env
EVENTSPY_HISTORY_ROOT=/srv/eventspy

# Provider credentials use non-PUBLIC names and belong only in the operator
# copy. Example (leave commented until an approved adapter requires it):
# Set TICKETMASTER_API_KEY only in the root-owned operator copy.
