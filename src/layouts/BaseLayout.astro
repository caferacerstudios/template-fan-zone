---
import { absoluteUrl } from "../lib/seo";
import { AD_CLIENT_ID, AD_PHASE, AD_PRODUCTION_HOSTS, AD_VERIFICATION_CONFIGURED, ADVERTISING_CONFIGURED, CMP_SCRIPT_URL } from "../lib/advertising";

const {
  title = "{Team} Fan Zone",
  description = "",
  canonical,
  article,
  structuredData,
  monetizationEligible = true,
  pageType,
  season,
  opponent,
  articleCategory,
  seo = { title, description, canonicalPath: canonical ?? Astro.url.pathname },
} = Astro.props;
const resolvedArticle = seo.article ?? article;
const canonicalUrl = seo.canonicalPath ? absoluteUrl(seo.canonicalPath) : null;
const jsonLd = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const advertisingConfigured = ADVERTISING_CONFIGURED && monetizationEligible;
const privacyConfig = { phase: AD_PHASE, publisherId: AD_CLIENT_ID, productionHosts: AD_PRODUCTION_HOSTS,
  cmpScriptUrl: CMP_SCRIPT_URL, monetizationEligible: advertisingConfigured };
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{seo.title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {AD_VERIFICATION_CONFIGURED && <meta name="google-adsense-account" content={AD_CLIENT_ID} />}
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots ?? "index, follow"} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="alternate" type="application/rss+xml" title="{Team} Fan Zone News" href={absoluteUrl("/news/rss.xml")} />
    <meta property="og:title" content={seo.openGraphTitle ?? seo.title} />
    <meta property="og:description" content={seo.openGraphDescription ?? seo.description} />
    <meta property="og:type" content={resolvedArticle ? "article" : "website"} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {seo.openGraphImage && <meta property="og:image" content={absoluteUrl(seo.openGraphImage)} />}
    {seo.openGraphImage && <meta property="og:image:alt" content={seo.openGraphImageAlt ?? seo.openGraphTitle ?? seo.title} />}
    <meta name="twitter:card" content={seo.openGraphImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={seo.openGraphTitle ?? seo.title} />
    <meta name="twitter:description" content={seo.openGraphDescription ?? seo.description} />
    {seo.openGraphImage && <meta name="twitter:image" content={absoluteUrl(seo.openGraphImage)} />}
    {seo.openGraphImage && <meta name="twitter:image:alt" content={seo.openGraphImageAlt ?? seo.openGraphTitle ?? seo.title} />}
    {resolvedArticle?.publishedTime && <meta property="article:published_time" content={resolvedArticle.publishedTime} />}
    {resolvedArticle?.modifiedTime && <meta property="article:modified_time" content={resolvedArticle.modifiedTime} />}
    {resolvedArticle?.section && <meta property="article:section" content={resolvedArticle.section} />}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replaceAll("<", "\\u003c")} />)}

    <!-- Impact site verification -->
    <meta
      name="impact-site-verification"
      value="2e6bc996-daec-4978-9c6b-7be402806885"
    />

    <!-- Site CSS -->
    <link rel="stylesheet" href="/styles/main.css?v=20260828-layout" />
    {"{ThemeStylesheet}" && <link rel="stylesheet" href="{ThemeStylesheet}" />}
    {"{ThemeFavicon}" && <link rel="icon" type="image/svg+xml" href="{ThemeFavicon}" />}

    {ADVERTISING_CONFIGURED && <>
      <script is:inline id="sfz-privacy-config" type="application/json" set:html={JSON.stringify(privacyConfig).replaceAll("<", "\\u003c")} />
      <script is:inline defer src="/privacy-runtime.js"></script>
    </>}
  </head>

  <body data-team="{team}" data-theme="{ThemeKey}" data-page-type={pageType} data-season={season} data-opponent={opponent} data-article-category={articleCategory} data-indexable={!/\bnoindex\b/i.test(seo.robots ?? "index, follow") ? "true" : "false"} data-monetization-eligible={advertisingConfigured ? "true" : "false"}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />

  </body>
</html>
