---
import {Team}Layout from "../layouts/{Team}Layout.astro";
import TicketPublisherContent from "./tickets/TicketPublisherContent.astro";
import GameEditorial from "./game/GameEditorial.astro";
import GameDayGuide from "./game/GameDayGuide.astro";
import GameStateSection from "./game/GameStateSection.astro";
import {TICKET_FEATURE} from "../lib/tickets/config";
import {gameDayPageModel,ticketGameModels} from "../lib/game-details.mjs";
import {gamePageMetadata,sportsEventData} from "../lib/game-page.mjs";
import {EVENTSPY_COVERAGE} from "../lib/tickets/eventspy-coverage.mjs";
import scheduleData from "../data/nfl/{team}.json";
import gameRecaps from "../data/nfl/gameRecaps.json";
import gameEditorial from "../data/nfl/gameEditorial.json";
import watchGuide from "../data/nfl/watch-guide-2026.json";
import gameDayGuides from "../data/nfl/game-day-guides.json";
import manualGameStatus from "../data/nfl/game-status.json";
import {gamePresentation} from "../lib/game-state.mjs";
import {getWatchGuideEntry,isHttpUrl} from "../lib/watch-guide.mjs";
import {reconcileOfficialSchedule} from "../lib/schedule-guide.mjs";
import {gameIndexability,hasMeaningfulGameGuide,hasMeaningfulViewingInformation,pageRobots} from "../lib/indexability.mjs";
const { gameId = null, routeStyle = "tickets" } = Astro.props;
const sourceGames = Array.isArray(scheduleData?.games) ? scheduleData.games : [...(scheduleData?.gamesPreseason ?? []),...(scheduleData?.gamesRegular ?? []),...(scheduleData?.gamesPostseason ?? [])];
const completeScheduleData = { ...scheduleData, games:reconcileOfficialSchedule(sourceGames,watchGuide) };
const ticketModels = ticketGameModels(completeScheduleData, EVENTSPY_COVERAGE, gameRecaps);
const requestedGameId = String(gameId ?? EVENTSPY_COVERAGE[0]?.gameId ?? "");
const sourceGame = routeStyle === "games" ? gameDayPageModel(completeScheduleData, requestedGameId, EVENTSPY_COVERAGE, { editorial: gameEditorial, recaps: gameRecaps }) : null;
const presentation = sourceGame ? gamePresentation(sourceGame, manualGameStatus) : null;
const selectedGame = sourceGame && presentation ? { ...sourceGame, completed:presentation.state === "completed", seaScore:presentation.{team}Score, opponentScore:presentation.opponentScore, game:{ ...sourceGame.game, state:presentation.state, status:presentation.state === "completed" ? "Final" : presentation.state === "in_progress" ? "In progress" : sourceGame.game.status } } : sourceGame;
const canonicalPath = routeStyle === "tickets" ? "/tickets" : `/games/${encodeURIComponent(requestedGameId)}`;
const metadata = routeStyle === "games" ? gamePageMetadata(selectedGame) : null;
const pageTitle = routeStyle === "tickets" ? "{Location} {Team} Ticket Finder and Price Comparison" : metadata.title;
const description = routeStyle === "tickets" ? "Compare recent {Team} ticket price observations and provider options, understand fee and freshness limits, and review independent buying guidance." : metadata.description;
const watchEntry = selectedGame ? getWatchGuideEntry(selectedGame.game, watchGuide) : null;
const gameDayGuide = gameDayGuides?.games?.[requestedGameId] ?? null;
const gameDecision = routeStyle === "games" ? gameIndexability({game:selectedGame?.game,id:requestedGameId,opponentName:selectedGame?.opponentName,canonicalPath,hasRecap:Boolean(selectedGame?.recap?.text ?? selectedGame?.recap?.summary ?? selectedGame?.recap?.segments?.length ?? selectedGame?.recap?.bullets?.length),hasGuide:hasMeaningfulGameGuide(gameDayGuide),hasViewingInformation:hasMeaningfulViewingInformation(watchEntry)}) : null;
const emittedCanonicalPath = routeStyle === "games" ? canonicalPath : TICKET_FEATURE.canonical ? canonicalPath : undefined;
const robots = routeStyle === "games" ? pageRobots(gameDecision) : TICKET_FEATURE.robots;
const structuredData = routeStyle === "games" && selectedGame
  ? sportsEventData(selectedGame, metadata, new URL(canonicalPath, Astro.site ?? Astro.url).toString())
  : null;
const navigationLabel = (game) => {
  const opponent = game?.opponent?.full_name ?? game?.opponent?.fullName ?? game?.opponent?.name ?? game?.opponent?.abbreviation ?? "opponent";
  return game?.isHome ? `${opponent} at {Location}` : `{Location} at ${opponent}`;
};
const gameModels=JSON.stringify(ticketModels).replaceAll("<","\\u003c");
const isBye = selectedGame?.game?.state === "bye";
const completedPreseason = selectedGame?.completed && selectedGame?.game?.phase === "preseason";
const watchHeading = completedPreseason ? "Broadcast and Replay" : selectedGame?.completed ? "Broadcast Information" : "Where to Watch";
const localTv = watchEntry?.localTv ?? [];
const streams = (watchEntry?.streams ?? []).filter((provider) => provider?.name !== "NFL Sunday Ticket");
const outOfMarket = (watchEntry?.streams ?? []).filter((provider) => provider?.name === "NFL Sunday Ticket");
const replay = watchEntry?.replay ?? [];
const externalLink = (item) => item?.name && isHttpUrl(item?.url) ? item : null;
const updatedLabel = watchGuide.updatedAt ? new Intl.DateTimeFormat("en-US", { month:"long", day:"numeric", year:"numeric", timeZone:"UTC" }).format(new Date(`${watchGuide.updatedAt}T12:00:00Z`)) : null;
---
<{Team}Layout title={pageTitle} description={description} seo={{title:pageTitle,description,canonicalPath:emittedCanonicalPath,robots}} structuredData={structuredData} activePath={routeStyle === "tickets" ? "/tickets" : ""} pageType="game_center" monetizationEligible={false} showPageHeader={false} breadcrumbs={[{name:"Home",href:"/"},{name:routeStyle === "tickets" ? "Tickets" : "Schedule",href:routeStyle === "tickets" ? "/tickets" : "/schedule"},{name:metadata?.h1 ?? pageTitle,href:canonicalPath}]}>
<TicketPublisherContent {routeStyle} game={selectedGame} pageMetadata={metadata} eligibleGames={Object.values(ticketModels)} section="intro" />
{routeStyle === "games" && selectedGame && !isBye && (
  <div class="game-guide-cards">
      {(watchEntry || !selectedGame.completed) && <section class="detail-panel viewing-panel">
        <h2>{watchHeading}</h2>
        {watchEntry ? <>
          <dl class="watch-details">
            {watchEntry.dateLabel && watchEntry.status === "tbd" && <div><dt>Date</dt><dd>{watchEntry.dateLabel}</dd></div>}
            {watchEntry.kickoffLabel && <div><dt>Kickoff</dt><dd>{watchEntry.kickoffLabel}</dd></div>}
            {watchEntry.originalBroadcast && <div><dt>Original {Location} broadcast</dt><dd>{watchEntry.originalBroadcast}</dd></div>}
            {watchEntry.result && <div><dt>Final result</dt><dd>{watchEntry.result}</dd></div>}
            {localTv.length > 0 && <div><dt>{localTv.some((station) => station.note === "Special local simulcast") ? "Special local simulcast" : "{Location} TV"}</dt><dd>{localTv.map((station) => station.name).join(" · ")}</dd></div>}
            {watchEntry.national && <div><dt>National broadcast</dt><dd>{watchEntry.national}</dd></div>}
            {streams.length > 0 && <div><dt>Stream</dt><dd>{streams.map((provider) => provider.name).join(" · ")}</dd></div>}
            {outOfMarket.length > 0 && <div><dt>Out of market</dt><dd>{outOfMarket.map((provider) => provider.name).join(" · ")}</dd></div>}
            {replay.length > 0 && <div><dt>Replay</dt><dd>{replay.map((provider) => provider.name).join(" · ")}</dd></div>}
          </dl>
          <div class="watch-links">
            {streams.map((provider) => externalLink(provider)).filter(Boolean).map((provider) => <a href={provider.url} target="_blank" rel="noopener noreferrer">Open {provider.name}</a>)}
            {outOfMarket.map((provider) => externalLink(provider)).filter(Boolean).map((provider) => <a href={provider.url} target="_blank" rel="noopener noreferrer">{provider.name}</a>)}
            {replay.map((provider) => externalLink(provider)).filter(Boolean).map((provider) => <a href={provider.url} target="_blank" rel="noopener noreferrer">Replay on {provider.name}</a>)}
            {isHttpUrl(watchEntry.officialGameUrl) && <a href={watchEntry.officialGameUrl} target="_blank" rel="noopener noreferrer">Official {Team} game {completedPreseason ? "center" : "page"}</a>}
          </div>
          {(streams.some((provider) => provider.note) || outOfMarket.some((provider) => provider.note) || replay.some((provider) => provider.note)) && <div class="watch-notes">{[...streams, ...outOfMarket, ...replay].filter((provider) => provider.note).map((provider) => <p><strong>{provider.name}:</strong> {provider.note}</p>)}</div>}
          {/\bregional coverage\b/i.test(watchEntry.national ?? "") && <p class="watch-note">Availability depends on your local broadcast market.</p>}
          {updatedLabel && <p class="watch-updated">Last updated <time datetime={watchGuide.updatedAt}>{updatedLabel}</time></p>}
        </> : <p>Viewing information coming soon.</p>}
      </section>}
      {!selectedGame.completed && <GameDayGuide guide={gameDayGuide} />}
  </div>
)}
{routeStyle === "games" && selectedGame && presentation?.state !== "upcoming" ? <GameStateSection game={selectedGame} {presentation} /> : <section id="ticket-price-explorer" aria-label="Interactive Ticket Finder" data-initial-game-id={requestedGameId} data-route-style={routeStyle} aria-busy="true"><div class="loading" role="status"><h2>Interactive price observations</h2><p>Ticket price data is loading. If it is unavailable, use the game information and ticket-buying guide on this page.</p></div></section>}
{(routeStyle === "tickets" || presentation?.state === "upcoming") && <TicketPublisherContent {routeStyle} game={selectedGame} eligibleGames={Object.values(ticketModels)} section="supporting" />}
{routeStyle === "games" && selectedGame && (
  <section class="server-game-support" aria-label="Game information and navigation">
    <GameEditorial game={selectedGame} matchup={metadata.matchup} />
    <nav class="game-nav" aria-label="Game navigation">
      {selectedGame.previousId ? <a href={`/games/${encodeURIComponent(selectedGame.previousId)}/`}>← Previous: {navigationLabel(selectedGame.previous)}</a> : <span>First tracked game</span>}
      <a class="schedule" href="/schedule">Full schedule</a>
      {selectedGame.nextId ? <a class="next" href={`/games/${encodeURIComponent(selectedGame.nextId)}/`}>Next: {navigationLabel(selectedGame.next)} →</a> : <span class="next">Last tracked game</span>}
    </nav>
  </section>
)}
{(routeStyle === "tickets" || presentation?.state === "upcoming") && <script type="application/json" id="ticket-game-models" set:html={gameModels}></script>}
</{Team}Layout>
<style is:global>
body:has(#ticket-price-explorer) .lr-middle{max-width:none}body:has(#ticket-price-explorer) .lr-main,body:has(#ticket-price-explorer) .lr-paper{width:100%;max-width:none;margin:0;padding:0;background:#f3f5f7;box-shadow:none}body:has(#ticket-price-explorer) .seo-breadcrumbs{display:none}.skip-link{position:fixed;left:.75rem;top:.75rem;transform:translateY(-200%);z-index:1000}.skip-link:focus{transform:none}#ticket-price-explorer{--navy:#002244;--green:#69be28;--ink:#0b1f35;--muted:#536171;--line:#d7dfe6;--surface:#fff;--soft:#f7f9fa;--shadow:0 8px 24px rgba(0,34,68,.08);width:min(1160px,calc(100% - 3rem));margin:clamp(1.25rem,3vw,2rem) auto 3.5rem;color:var(--ink)}.loading{min-height:28rem;display:grid;place-content:center}.game-picker{display:grid;grid-template-columns:minmax(12rem,auto) minmax(0,1fr);gap:.55rem 1.25rem;align-items:center;margin:0 0 1.25rem;padding:1rem 1.25rem;background:var(--surface);border:1px solid var(--line);border-radius:.75rem;box-shadow:0 2px 10px rgba(0,34,68,.05)}.game-picker label{font-size:1rem;font-weight:800}.game-picker select{width:100%;min-width:0;min-height:48px;border:1px solid #8c9aa7;border-radius:.45rem;padding:.65rem 2.5rem .65rem .85rem;background:#fff;color:var(--ink);font:700 1rem/1.3 inherit}.event-head{position:relative;overflow:hidden;background:var(--navy);color:#fff;padding:clamp(1.5rem,3.5vw,2.5rem);border-radius:1rem;border-bottom:6px solid var(--green);box-shadow:var(--shadow)}.event-head:after{content:"";position:absolute;inset:0 0 0 auto;width:28%;background:linear-gradient(135deg,transparent,rgba(105,190,40,.1));pointer-events:none}.eyebrow{position:relative;z-index:1;margin:0 0 .45rem;color:#c9e7b5;font-size:.85rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.event-head h1{position:relative;z-index:1;max-width:900px;color:#fff;font-size:clamp(2rem,4.5vw,3.35rem);line-height:1.05;margin:0 0 1.15rem;text-wrap:balance}.event-meta{position:relative;z-index:1;display:grid;grid-template-columns:repeat(3,max-content);gap:.35rem 1.75rem;font-size:.98rem;font-weight:700}.event-meta span{display:flex;align-items:center}.event-meta span+span:before{content:"";width:4px;height:4px;margin-right:1.75rem;border-radius:50%;background:var(--green)}.last-checked{position:relative;z-index:1;display:inline-flex;margin:1rem 0 0;padding:.4rem .65rem;border:1px solid rgba(255,255,255,.26);border-radius:.4rem;background:rgba(255,255,255,.08);font-size:.9rem;font-weight:800}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.25rem 0;align-items:stretch}.card{display:flex;min-height:11rem;flex-direction:column;align-items:center;justify-content:center;background:var(--surface);border:1px solid var(--line);border-radius:.8rem;padding:1.25rem;text-align:center;box-shadow:0 4px 16px rgba(0,34,68,.06)}.card.current-lowest{border-color:#9bcf77;box-shadow:inset 0 4px 0 var(--green),0 6px 18px rgba(45,111,19,.1)}.card h2{margin:0;color:var(--muted);font-size:.95rem;letter-spacing:.035em;text-transform:uppercase}.price,.days{font:900 clamp(2.15rem,4vw,3rem)/1 var(--font-display);margin:.7rem 0;color:var(--navy)}.price.current{color:#245f12}.age,.disclosure{font-size:.9rem;line-height:1.55;color:var(--muted)}.age{margin:0}.low-badge{display:inline-flex;align-items:center;min-height:28px;background:#e6f4dc;color:#225d0a;border:1px solid #acd18e;padding:.2rem .65rem;border-radius:999px;font-size:.82rem;font-weight:900}.card .low-badge{margin-top:.65rem}.starting{margin:1.5rem 0 .25rem;text-align:center;color:var(--muted)}.starting strong{color:var(--ink)}.providers-title{margin:.3rem 0 0;text-align:center;font-size:clamp(1.55rem,3vw,2rem)}.providers{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin:1rem auto 2rem}.provider-card{position:relative;min-width:0;min-height:12rem;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:1.25rem;background:var(--surface);border:1px solid #bdc8d1;border-radius:.8rem;color:var(--ink);text-decoration:none;box-shadow:0 3px 12px rgba(0,34,68,.06);transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}.provider-card:hover{transform:translateY(-2px);border-color:var(--navy);box-shadow:var(--shadow)}.provider-card[data-lowest-price="true"]{border:2px solid #4f981f;background:linear-gradient(180deg,#f5fbf1 0,#fff 45%);box-shadow:inset 0 4px 0 var(--green),0 6px 20px rgba(45,111,19,.12)}.provider-name{padding-right:1.5rem;font-size:1.1rem;font-weight:900}.provider-label,.provider-age{font-size:.88rem;color:var(--muted)}.provider-price{max-width:100%;font:900 clamp(1.65rem,3vw,2.15rem)/1 var(--font-display);margin:.55rem 0;color:var(--navy);overflow-wrap:anywhere}.provider-external{position:absolute;right:1rem;top:.9rem;color:#245f12;font-size:1.15rem;font-weight:900}.provider-card .low-badge{margin-top:.75rem}.history-panel{background:var(--surface);padding:clamp(1.1rem,3vw,2rem);border:1px solid var(--line);border-radius:1rem;box-shadow:var(--shadow)}.history-top{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.5rem;align-items:end}.history-top h2{margin:0 0 .35rem;font-size:clamp(1.55rem,3vw,2rem)}.subtitle{max-width:38rem;margin:0;color:var(--muted);line-height:1.5}.controls{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;justify-content:flex-end}.controls button,.controls select{min-height:44px;border:1px solid #8c9aa7;border-radius:.4rem;background:#fff;padding:.55rem .8rem;color:var(--ink);font-weight:800}.controls button:hover{border-color:var(--navy);background:#eef2f5}.controls button[aria-pressed=true]{border-color:var(--navy);background:var(--navy);color:#fff}.controls label{margin-left:.35rem;font-size:.9rem;font-weight:800}.legend{display:flex;gap:.7rem 1.25rem;flex-wrap:wrap;align-items:center;margin:1.25rem 0 .75rem;padding:0;list-style:none}.legend li{display:flex;align-items:center;font-size:.9rem;font-weight:700}.legend-swatch{display:inline-block;width:1.35rem;border-top:4px solid var(--c);margin-right:.4rem}.chart-wrap{position:relative;width:100%;overflow:hidden;border:1px solid var(--line);border-radius:.55rem;background:var(--soft)}.chart{display:block;width:100%;height:auto;min-height:250px}.chart:empty{display:none}.grid{stroke:#d9e0e5;stroke-width:1}.axis{fill:#4b5967;font-size:14px;font-weight:600}.axis.date{text-anchor:middle}.series{fill:none;stroke-width:3.5;stroke-linecap:round;stroke-linejoin:round}.endpoint{stroke:#fff;stroke-width:2}.history-panel details{margin-top:1rem;border-top:1px solid var(--line);padding-top:.35rem}.history-panel summary{display:flex;min-height:44px;align-items:center;width:max-content;max-width:100%;cursor:pointer;color:var(--navy);font-weight:850}.table-wrap{max-width:100%;overflow:auto;margin-top:.5rem;border-radius:.4rem}table{width:100%;border-collapse:collapse;font-size:.9rem}th,td{padding:.65rem;border:1px solid var(--line);white-space:nowrap}thead th{background:#eef2f5;color:var(--navy)}.disclosure{margin:1rem .25rem 0}.error,.unavailable{min-height:18rem;padding:2rem;background:#fff;border-left:5px solid #c33;border-radius:.5rem}.unavailable{border-color:var(--green)}.stale{background:#fff1c7;padding:.65rem;text-align:center;font-weight:800;border-radius:.4rem}:is(a,button,select,input,summary):focus-visible{outline:3px solid var(--green,#69be28);outline-offset:3px}@media(max-width:900px){.providers{grid-template-columns:repeat(2,minmax(0,1fr))}.history-top{grid-template-columns:1fr}.controls{justify-content:flex-start}.event-meta{grid-template-columns:1fr}.event-meta span+span:before{display:none}}@media(max-width:600px){#ticket-price-explorer{width:calc(100% - 1.5rem);margin-top:.75rem}.game-picker{grid-template-columns:1fr;padding:.9rem}.event-head{padding:1.35rem 1.1rem}.event-head h1{font-size:clamp(1.8rem,9vw,2.5rem);margin-bottom:1rem}.event-meta{font-size:.92rem}.last-checked{display:flex;font-size:.85rem;line-height:1.45}.cards,.providers{grid-template-columns:1fr}.card{min-height:9rem}.provider-card{min-height:10.5rem}.controls{display:grid;grid-template-columns:repeat(3,1fr)}.controls button{width:100%}.controls label,.controls select{grid-column:1/-1;margin-left:0}.chart-wrap{overflow-x:auto}.chart{width:680px;min-height:265px}.disclosure{font-size:.85rem}}@media(max-width:380px){#ticket-price-explorer{width:calc(100% - 1rem)}.history-panel{padding:.85rem}.controls{gap:.4rem}.provider-price{font-size:1.7rem}}@media print{.game-picker,.controls{display:none!important}}@media(prefers-reduced-motion:reduce){#ticket-price-explorer *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
.chart-note{margin:0 0 .75rem;color:var(--muted);font-size:.85rem;line-height:1.45}
.game-day-heading{width:min(1160px,calc(100% - 3rem));margin:1.25rem auto 0;font-size:clamp(1.35rem,3vw,2rem);line-height:1.15}.unavailable{min-height:0!important;margin:1rem 0;padding:1rem 1.1rem!important}.future-features p{margin:0;color:var(--muted)}
.server-game-support{--navy:#002244;--green:#69be28;--ink:#0b1f35;--muted:#536171;--line:#d7dfe6;--soft:#f7f9fa;width:min(1160px,calc(100% - 3rem));margin:1.25rem auto 3.5rem;color:var(--ink)}
.game-guide-cards{--navy:#002244;--green:#69be28;--ink:#0b1f35;--muted:#536171;--line:#d7dfe6;--soft:#f7f9fa;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;width:min(1160px,calc(100% - 3rem));margin:1.25rem auto;color:var(--ink)}.game-guide-cards .detail-panel{margin:0}.game-guide-cards .detail-panel:only-child{grid-column:1/-1}.game-guide-cards p,.game-guide-cards li{line-height:1.65}.game-guide-cards ul{padding-left:1.25rem}
.watch-details{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:.55rem;margin:0!important}.watch-details div{padding:.65rem!important;border-left:3px solid #d7dfe6}.watch-links{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.9rem}.watch-links a{display:inline-flex;min-height:38px;align-items:center;padding:.4rem .65rem;border:2px solid var(--navy);background:var(--navy);color:#fff;font-size:.78rem;font-weight:900;text-decoration:none}.watch-links a:hover{background:#08345e}.watch-notes,.watch-note{margin-top:.7rem;color:var(--muted);font-size:.78rem}.watch-notes p{margin:.2rem 0}.watch-updated{margin:.8rem 0 0!important;color:var(--muted);font-size:.72rem;font-weight:800;text-transform:uppercase}
.game-hero{overflow:hidden;background:var(--navy);color:#fff;border-top:7px solid var(--green);border-radius:1rem;box-shadow:var(--shadow)}.hero-top,.hero-details{display:flex;justify-content:space-between;gap:.6rem 1.25rem;flex-wrap:wrap;padding:.75rem 1rem;background:#ffffff0d;font-size:.78rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.hero-teams{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;padding:clamp(1.2rem,4vw,2.4rem)}.hero-team{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:.2rem .8rem}.hero-team img{grid-row:1/4;width:clamp(58px,8vw,86px);height:clamp(58px,8vw,86px);object-fit:contain}.hero-team strong{font-size:clamp(1rem,2.2vw,1.35rem)}.hero-team b{font:900 clamp(1.8rem,5vw,3.25rem)/1 var(--font-display)}.hero-team small{color:#c9d2dc;text-transform:uppercase}.hero-opponent{text-align:right;grid-template-columns:1fr auto}.hero-opponent img{grid-column:2}.hero-opponent strong,.hero-opponent b,.hero-opponent small{grid-column:1}.hero-opponent strong{grid-row:1}.hero-opponent b{grid-row:2}.hero-opponent small{grid-row:3}.hero-vs{color:var(--green);font-weight:900;text-transform:uppercase}.hero-details{justify-content:flex-start;background:#08345e;letter-spacing:0;text-transform:none}.game-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:1.25rem 0}.detail-panel{min-width:0;padding:1.1rem;background:#fff;border:1px solid var(--line);border-radius:.7rem}.detail-panel h2{margin:0 0 .8rem;padding-left:.6rem;border-left:4px solid var(--green);font-size:1.1rem}.detail-panel dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:0}.detail-panel dl div{padding:.65rem;background:var(--soft)}.detail-panel dt{font-size:.75rem;color:var(--muted);text-transform:uppercase}.detail-panel dd{margin:.2rem 0 0;font-weight:900}.game-nav{display:grid;grid-template-columns:1fr auto 1fr;gap:.6rem;margin:1rem 0}.game-nav a,.game-nav span{padding:.75rem;background:#fff;border:1px solid var(--line);text-decoration:none;font-weight:850}.game-nav .next{text-align:right}.historical-note{margin:1rem 0;padding:.85rem 1rem;border-left:5px solid var(--green);background:#fff;font-weight:800}
@media(max-width:650px){.hero-teams{grid-template-columns:1fr}.hero-vs{text-align:center}.hero-opponent{text-align:left;grid-template-columns:auto 1fr}.hero-opponent img{grid-column:1;grid-row:1/4}.hero-opponent strong,.hero-opponent b,.hero-opponent small{grid-column:2}.game-details,.game-guide-cards{grid-template-columns:1fr}.game-guide-cards{width:calc(100% - 1.5rem)}.watch-details{grid-template-columns:1fr!important}.game-nav{grid-template-columns:1fr 1fr}.game-nav .schedule{grid-column:1/-1;grid-row:2;text-align:center}}
</style>
<script>
