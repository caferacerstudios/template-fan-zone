---
import { AD_CLIENT_ID, ADVERTISING_CONFIGURED } from "../lib/advertising";
interface Props {
  client: string;
  slot: string;
  width?: number;
  height?: number;
  label?: string;
}

const { client, slot, width = 300, height = 250 } = Astro.props;
const render = ADVERTISING_CONFIGURED && client === AD_CLIENT_ID && /^\d+$/.test(String(slot ?? ""));
---

{render && <aside hidden data-sfz-ad-container class="ad-slot" style={`--ad-width:${width}px;--ad-height:${height}px`} aria-label="Advertisement">
  <span>Advertisement</span>
  <ins data-sfz-ad class="ad-slot__unit" data-ad-client={AD_CLIENT_ID} data-ad-slot={slot}></ins>
</aside>}

<!-- Requests are owned by privacy-runtime.js and always pass its consent gate. -->
<style>
  .ad-slot[hidden] { display:none; }
  .ad-slot { width:min(100%,var(--ad-width)); min-height:var(--ad-height); contain:layout paint; display:grid; place-items:center; overflow:hidden; background:var(--slate-100); color:var(--slate-700); }
  .ad-slot > span { font-size:.68rem; letter-spacing:.08em; text-transform:uppercase; }
  .ad-slot__unit { display:block; width:100%; height:var(--ad-height); }
</style>
