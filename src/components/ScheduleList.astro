---
import TeamMark from "./TeamMark.astro";
import { groupScheduleMonths, scheduleGameMatches, scheduleRow } from "../lib/schedule-display.mjs";
import { gameCalendar } from "../lib/game-day.mjs";
import { TICKET_FEATURE } from "../lib/tickets/config";
import watchGuide from "../data/nfl/watch-guide-2026.json";
import { getWatchGuideEntry, watchGuideScheduleLines } from "../lib/watch-guide.mjs";

const { sections, nextGameId, canonicalBase, filterState = { status: "all", filters: [] } } = Astro.props;
const slug = (value) => String(value).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const monthLinks = sections.flatMap((section) => groupScheduleMonths(section.games).map((group, index) => ({ href: `#${section.id}-${slug(group.label)}-${index}`, label: group.label })));
---

<nav class="phase-jumps" aria-label="Jump within schedule">
  {nextGameId && <a href="#next-game">Next game</a>}
  {sections.map((section) => <a href={`#${section.id}`}>{section.label}<span>{section.games.length}</span></a>)}
  {monthLinks.map((month) => <a class="month-jump" href={month.href}>{month.label}</a>)}
</nav>

{sections.map((section) => <section class="schedule-phase" id={section.id} aria-labelledby={`${section.id}-title`} data-schedule-phase>
  <header class="phase-title"><h2 id={`${section.id}-title`}>{section.label}</h2><span>{section.games.length} {section.games.length === 1 ? "week" : "weeks"}</span></header>
  {section.games.length ? groupScheduleMonths(section.games).map((group, groupIndex) => {
    const monthId = `${section.id}-${slug(group.label)}-${groupIndex}`;
    return <section class="month-group" aria-labelledby={monthId} data-month-group>
      <h3 id={monthId}>{group.label}</h3>
      <div class="schedule-grid" tabindex="0" role="region" aria-label={`${section.label}, ${group.label} table`}>
        <table>
        <caption>{section.label} games in {group.label}</caption>
        <thead><tr class="schedule-head">
          <th scope="col">Week</th><th scope="col">Day & date</th><th scope="col">Opponent</th>
          <th scope="col">Kickoff</th><th scope="col">TV / stream</th><th scope="col">Venue</th>
          <th scope="col">Status / result</th><th scope="col">Action</th>
        </tr></thead>
        <tbody>
          {group.games.map((game, index) => {
            const row = scheduleRow(game, { nextGameId, index });
            const watchLines = watchGuideScheduleLines(getWatchGuideEntry(game, watchGuide));
            const calendar = gameCalendar(game, canonicalBase);
            const copyText = [row.week, `${row.homeAwayLabel}: ${row.opponentName}`, `${row.date}, ${row.kickoff}`, row.network && `Watch: ${row.network}`, row.venue && `Venue: ${row.venue}`, row.resultLabel].filter(Boolean).join(" · ");
            const gameAttrs = { "data-schedule-game": "", "data-state": row.state, "data-phase": section.id, "data-location": game?.isHome ? "home" : "away", "data-division": String(row.division), "data-prime-time": String(row.primeTime) };
            const initiallyHidden = !scheduleGameMatches(game, filterState);
            return row.kind === "bye" ? <tr class="schedule-row bye-row" {...gameAttrs} hidden={initiallyHidden}>
              <th class="week-status" scope="row"><strong>{row.week}</strong><span class="state-badge">Bye</span></th>
              <td class="bye-message" colspan="7"><strong>Bye week</strong><span>{row.detail}</span></td>
            </tr> : <tr class:list={["schedule-row", `state-${row.state}`]} {...gameAttrs} hidden={initiallyHidden}>
              <th class="week-status" scope="row" data-label="Week"><strong>{row.week}</strong><span class="mobile-state">{row.stateLabel}</span></th>
              <td class="date-cell" data-label="Day and date">{row.date}</td>
              <td class="opponent-cell" data-label={row.homeAwayLabel}>
                <TeamMark abbreviation={row.opponentAbbr} name={row.opponentName} size={40} decorative loading="lazy" />
                <div><span class="location-word"><span class="sr-only">{row.homeAwayLabel}, </span>{row.homeAway}</span><strong>{row.opponentName}</strong><div class="badges">{row.division && <span>Division</span>}{row.primeTime && <span>Prime Time</span>}</div></div>
              </td>
              <td class="kickoff-cell" data-label="Kickoff">{row.kickoff}</td>
              <td class="network-cell" data-label={watchLines.length || row.network ? "TV or stream" : undefined}>{watchLines.length ? watchLines.map((line) => <span>{line}</span>) : row.network}</td>
              <td class="venue-cell" data-label={row.venue ? "Venue" : undefined}>{row.venue}</td>
              <td class="result-cell" data-label="Status or result">{row.result && <span class:list={["result-mark", `result-${row.result.outcome.toLowerCase()}`]}>{row.result.outcome}</span>}<strong>{row.resultLabel ?? row.stateLabel}</strong>{row.record && <small>Record {row.record}</small>}</td>
              <td class="action-cell">
                <a href={row.href} rel={/^https?:/.test(row.href) ? "noopener noreferrer" : undefined}>{row.action}<span aria-hidden="true"> →</span></a>
                <details class="more-actions"><summary aria-label={`More actions for {Team} ${row.homeAway === "vs" ? "versus" : "at"} ${row.opponentName}`}>More</summary><div>
                  {calendar.enabled && <a href={calendar.href} download={calendar.filename}>Add this game to calendar</a>}
                  <button type="button" class="copy-game" data-copy={copyText}>Copy game information</button>
                  {row.venueUrl && <a href={row.venueUrl} target="_blank" rel="noopener noreferrer" aria-label={`Venue information for ${row.venue} (opens in a new tab)`}>Venue information</a>}
                  {row.watchUrl && <a href={row.watchUrl} target="_blank" rel="noopener noreferrer" aria-label={`Watch or listen information for {Team} ${row.homeAway === "vs" ? "versus" : "at"} ${row.opponentName} (opens in a new tab)`}>Watch/listen information</a>}
                  {TICKET_FEATURE.enabled && !['completed', 'canceled'].includes(row.state) && <a href={`/tickets?game=${encodeURIComponent(String(game.id))}`}>Check ticket availability</a>}
                </div></details>
              </td>
            </tr>;
          })}
        </tbody></table>
      </div>
    </section>;
  }) : <div class="empty-state"><h3>{section.id === "postseason" ? "The playoff picture is still taking shape" : `No ${section.label.toLowerCase()} games are available`}</h3><p>Games will appear here when matchups are confirmed.</p></div>}
</section>)}

<style>
  .phase-jumps{display:flex;gap:.4rem;overflow-x:auto;margin:1rem 0 1.35rem;padding:.35rem;background:var(--slate-300);scrollbar-gutter:stable}
  .phase-jumps a{display:flex;align-items:center;gap:.55rem;min-height:44px;flex:0 0 auto;padding:.45rem .7rem;background:#fff;color:var(--navy-900);font:800 .78rem var(--font-display);text-decoration:none}
  .phase-jumps a:hover,.phase-jumps a:focus-visible{background:var(--navy-800);color:#fff}.phase-jumps span{display:grid;min-width:1.35rem;height:1.35rem;place-items:center;border-radius:50%;background:#00224415;font-size:.67rem}
  .schedule-phase{scroll-margin-top:1rem}.schedule-phase+.schedule-phase{margin-top:2rem}.phase-title{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding-bottom:.45rem;border-bottom:4px solid var(--navy-800)}
  .phase-title h2{margin:0;font-size:1.35rem;text-transform:uppercase}.phase-title>span{color:var(--slate-700);font-size:.75rem;font-weight:800;text-transform:uppercase}
  .month-group{margin-top:.8rem;scroll-margin-top:1rem}.month-group h3{margin:0;padding:.34rem .6rem;background:var(--navy-800);color:#fff;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}
  .schedule-grid{max-width:100%;overflow-x:auto;border:var(--border-crisp);border-top:0;background:#fff;scrollbar-gutter:stable}.schedule-grid:focus-visible{outline:3px solid var(--action-green);outline-offset:2px}table{width:100%;min-width:790px;border-collapse:collapse;table-layout:fixed}caption{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.schedule-head{background:var(--slate-100);color:var(--slate-700);font-size:.61rem;letter-spacing:.03em;text-transform:uppercase}.schedule-head th{padding:.45rem;text-align:left}.schedule-head th:nth-child(1){width:7%}.schedule-head th:nth-child(2){width:11%}.schedule-head th:nth-child(3){width:22%}.schedule-head th:nth-child(4){width:9%}.schedule-head th:nth-child(5){width:9%}.schedule-head th:nth-child(6){width:14%}.schedule-head th:nth-child(7){width:16%}.schedule-head th:nth-child(8){width:12%}
  .schedule-row{border-top:1px solid var(--slate-300);font-size:.75rem;font-variant-numeric:tabular-nums}.schedule-row>*{min-width:0;padding:.5rem .45rem;text-align:left;vertical-align:middle;overflow-wrap:anywhere}.schedule-row.state-completed{box-shadow:inset 4px 0 var(--navy-800)}.schedule-row.state-next{background:linear-gradient(90deg,#69be2818,transparent 50%);box-shadow:inset 4px 0 var(--action-green)}.schedule-row.state-in_progress{box-shadow:inset 4px 0 var(--action-green)}.schedule-row.state-tbd{background:var(--slate-100)}
  .week-status{padding-left:.6rem!important;color:var(--slate-700);font-size:.68rem;text-transform:uppercase}.week-status strong,.state-badge{display:block}.mobile-state{display:none}.date-cell,.kickoff-cell,.network-cell{font-weight:800}.opponent-cell :global(.team-mark){vertical-align:middle;margin-right:.35rem}.opponent-cell>div{display:inline-block;max-width:calc(100% - 50px);vertical-align:middle}.opponent-cell strong{display:block;line-height:1.15}.location-word{float:left;margin-right:.25rem;color:var(--slate-700);font-size:.68rem;font-weight:900;text-transform:uppercase}.badges{display:flex;gap:.25rem;margin-top:.22rem}.badges span,.state-badge{width:max-content;padding:.12rem .3rem;background:#00224412;color:var(--navy-900);font-size:.58rem;font-weight:900;letter-spacing:.03em;text-transform:uppercase}.venue-cell,.network-cell{overflow-wrap:anywhere;color:var(--slate-700)}
  .network-cell span,.result-cell strong,.result-cell small{display:block}.result-cell small{color:var(--slate-700)}.result-mark{display:inline-grid;width:1.45rem;height:1.45rem;margin-right:.25rem;place-items:center;background:var(--action-green);color:var(--navy-950);font-weight:950}.result-l{background:#9f2d27;color:#fff}.result-t{background:var(--slate-500);color:var(--navy-950)}.action-cell>a{font-weight:900}.more-actions{position:relative;margin-top:.2rem;color:var(--slate-700);font-size:.65rem}.more-actions summary{min-height:30px;cursor:pointer}.more-actions>div{position:absolute;z-index:3;right:0;width:190px;padding:.35rem;border:var(--border-crisp);background:#fff;box-shadow:var(--shadow-sm)}.more-actions a,.more-actions button{display:block;width:100%;min-height:44px;padding:.4rem;border:0;background:none;color:var(--navy-900);font:700 .7rem inherit;text-align:left;text-decoration:underline;white-space:normal;cursor:pointer}.bye-row{background:repeating-linear-gradient(135deg,var(--slate-100),var(--slate-100) 8px,#fff 8px,#fff 16px);box-shadow:inset 4px 0 var(--navy-800)}.bye-message strong{margin-right:.55rem}.bye-message span{color:var(--slate-700)}.empty-state{padding:1.25rem;border:var(--border-crisp);background:var(--slate-100);text-align:center}.empty-state h3,.empty-state p{margin:.2rem}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:820px){.schedule-grid{margin-inline:-.25rem}.schedule-row{font-size:.71rem}.schedule-phase+.schedule-phase{margin-top:1.5rem}}
  @media(max-width:360px){.phase-jumps a{font-size:.68rem}.phase-jumps span{display:none}}
</style>

<script>
  document.addEventListener("click", async (event) => {
    const button = event.target instanceof Element ? event.target.closest(".copy-game") : null;
    if (!(button instanceof HTMLButtonElement)) return;
    try {
      await navigator.clipboard.writeText(button.dataset.copy || "");
      button.textContent = "Copied";
    } catch { button.textContent = "Copy failed"; }
  });
</script>
