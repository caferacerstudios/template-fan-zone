---
import {Team}Layout from "../layouts/{Team}Layout.astro";
import SeasonContextView from "../components/SeasonContext.astro";
import ContinueFanZone from "../components/ContinueFanZone.astro";
import { getSeasonContext } from "../lib/season-context";
import data from "../data/nfl/{team}.json";
import rosterStore from "../data/team/roster.json";
import injuriesStore from "../data/team/injuries.json";
import transactionsStore from "../data/team/transactions.json";
import { currentRosterDirectoryCount, currentRosterPlayers, practiceSquadPlayers, reserveRosterPlayers, rosterCount } from "../lib/roster.mjs";
import { latestPlayerUpdates } from "../lib/team-updates-core.mjs";

const active = currentRosterPlayers(rosterStore), practiceSquad = practiceSquadPlayers(rosterStore), reserve = reserveRosterPlayers(rosterStore);
const currentGroups = [
  { id:"active", title:"Active roster", players:active, caption:`Current ${rosterStore.season} Seattle {Team} active roster` },
  { id:"practice-squad", title:"Practice squad", players:practiceSquad, caption:`Current ${rosterStore.season} Seattle {Team} practice squad` },
  { id:"reserve", title:"Reserve status", players:reserve, caption:`Current ${rosterStore.season} Seattle {Team} reserve and exempt lists` },
];
const positions = [...new Set(currentGroups.flatMap((group) => group.players).map((p) => p.position).filter(Boolean))].sort();
const updates = latestPlayerUpdates([...(transactionsStore.records || []), ...(injuriesStore.records || [])], rosterStore);
const rosterGroups = currentGroups.map((group) => ({ ...group, players:group.players.map((p) => ({ ...p, update:updates.get(String(p.id)) })) }));
const rosterDirectoryCount = currentRosterDirectoryCount(rosterStore);
const sourceContext = getSeasonContext(data, "regular season");
const statsSeason = Number(data?.playerStatsSeason ?? sourceContext.sourceSeason ?? sourceContext.seasonYear);
const statsRows = Array.isArray(data?.playerSeasonStats) ? data.playerSeasonStats : [];
const statsContext = { ...sourceContext, seasonYear:statsSeason, sourceSeason:statsSeason, seasonStatus:statsSeason < Number(rosterStore.season) ? "complete" : sourceContext.seasonStatus, label:`${statsSeason} Regular Season`, hasData:statsRows.length > 0, hasStatistics:statsRows.length > 0 };
const num = (v) => typeof v === "number" && Number.isFinite(v) ? v : null;
const value = (row, keys) => { for (const key of keys) if (num(row?.[key]) !== null) return row[key]; return null; };
const pid = (row) => row?.player?.id ?? row?.player_id;
const pname = (row) => row?.player?.full_name || `${row?.player?.first_name || ""} ${row?.player?.last_name || ""}`.trim() || "Unknown player";
const ppos = (row) => String(row?.player?.position_abbreviation || row?.player?.position || "—").toUpperCase();
const score = (row) => Object.values(row || {}).filter((v) => num(v) !== null).length;
const best = new Map();
for (const row of statsRows) { const key=String(pid(row) ?? pname(row)); if (!best.has(key) || score(row)>score(best.get(key))) best.set(key,row); }
const uniqueStats = [...best.values()];
const definitions = [
  ["passing","Passing",["passing_yards"],[["Games played",["games_played"]],["Completions",["completions"]],["Attempts",["passing_attempts","attempts"]],["Passing yards",["passing_yards"]],["Passing TD",["passing_touchdowns"]],["Interceptions thrown",["passing_interceptions","interceptions_thrown"]]]],
  ["rushing","Rushing",["rushing_yards"],[["Games played",["games_played"]],["Carries",["rushing_attempts","carries"]],["Rushing yards",["rushing_yards"]],["Yards per carry",["yards_per_rush","rushing_average"]],["Rushing TD",["rushing_touchdowns"]]]],
  ["receiving","Receiving",["receiving_yards"],[["Games played",["games_played"]],["Receptions",["receptions"]],["Targets",["receiving_targets","targets"]],["Receiving yards",["receiving_yards"]],["Yards per catch",["yards_per_reception","receiving_average"]],["Receiving TD",["receiving_touchdowns"]]]],
  ["defense","Defense",["sacks","total_tackles","tackles"],[["Games played",["games_played"]],["Total tackles",["total_tackles","tackles"]],["Sacks",["sacks"]],["Defensive INT",["defensive_interceptions","interceptions"]],["Passes defended",["passes_defended","passes_defensed"]],["Forced fumbles",["forced_fumbles"]]]],
  ["kicking","Kicking",["field_goals_made","punts"],[["Games played",["games_played"]],["Field goals made",["field_goals_made"]],["Field goals attempted",["field_goals_attempted"]],["Extra points made",["extra_points_made"]],["Punts",["punts"]],["Punt average",["punt_average","punting_average"]]]],
  ["returns","Returns",["kick_return_yards","punt_return_yards","return_yards"],[["Games played",["games_played"]],["Kick returns",["kick_returns"]],["Kick-return yards",["kick_return_yards"]],["Punt returns",["punt_returns"]],["Punt-return yards",["punt_return_yards"]],["Return TD",["return_touchdowns","kick_return_touchdowns","punt_return_touchdowns"]]]],
];
const categories = definitions.map(([id,label,primary,cols]) => ({ id,label,primary,cols:cols.filter(([,keys]) => uniqueStats.some((r) => value(r,keys) !== null)), rows:uniqueStats.filter((r) => value(r,primary) !== null).sort((a,b)=>(value(b,primary)??0)-(value(a,primary)??0)) })).filter((c) => c.rows.length && c.cols.length);
const leaders = categories.filter((c) => ["passing","rushing","receiving","defense"].includes(c.id)).map((c) => {
  if (c.id !== "defense") return { label:`${c.label} leader`, row:c.rows[0], stat:value(c.rows[0],c.primary), metric:"YARDS" };
  const sackRow = uniqueStats.filter((row) => value(row,["sacks"]) !== null).sort((a,b)=>(value(b,["sacks"])??0)-(value(a,["sacks"])??0))[0];
  const tackleRow = uniqueStats.filter((row) => value(row,["total_tackles","tackles"]) !== null).sort((a,b)=>(value(b,["total_tackles","tackles"])??0)-(value(a,["total_tackles","tackles"])??0))[0];
  return sackRow ? { label:"Sack leader", row:sackRow, stat:value(sackRow,["sacks"]), metric:"SACKS" } : { label:"Tackle leader", row:tackleRow, stat:value(tackleRow,["total_tackles","tackles"]), metric:"TACKLES" };
}).filter((leader) => leader.row && leader.stat !== null);
const rosterDate = new Intl.DateTimeFormat("en-US",{month:"short",day:"numeric",year:"numeric",timeZone:"America/Los_Angeles"}).format(new Date(rosterStore.asOf));
---
<{Team}Layout title="Seattle {Team} Roster | {Team} Fan Zone" description={`Explore the current ${rosterStore.season} Seattle {Team} roster, including active, practice-squad, and reserve players, plus clearly labeled historical player statistics from the ${statsContext.label.toLowerCase()}.`} pageTitle="Seattle {Team} Roster" pageTagline="Current roster identity and historical player statistics, separated by purpose and season." activePath="/players" pageType="players" season={rosterStore.season} breadcrumbs={[{ name: "Home", href: "/" }, { name: "Roster", href: "/players" }]}>
  <section class="roster-intro"><div><p class="eyebrow">Current team</p><h2>{rosterStore.season} {Team} roster</h2><p>{rosterCount(rosterStore)} active players · {practiceSquad.length} practice-squad players · {reserve.length} on reserve or exempt lists</p></div><div class="context-badge"><span>Roster season</span><strong>{rosterStore.season}</strong><small>As of {rosterDate}</small></div></section>

  <section class="utility-section" aria-labelledby="directory-title">
    <div class="section-heading"><div><p class="eyebrow">Current roster</p><h2 id="directory-title">Current {Team} Roster</h2><p>Active roster, practice squad, and reserve status. Historical performance appears in the season-labeled statistics section below.</p></div><p id="roster-count" role="status" aria-live="polite"><strong>{rosterDirectoryCount}</strong> shown</p></div>
    <div class="filters"><label>Search players<input id="roster-search" type="search" placeholder="Name or number" autocomplete="off" /></label><label>Position<select id="roster-position"><option value="ALL">All positions</option>{positions.map((p) => <option value={p}>{p}</option>)}</select></label></div>
    <div id="roster-directory">{rosterGroups.map((group) => <section class="roster-group" aria-labelledby={`${group.id}-title`}><div class="roster-group-heading"><h3 id={`${group.id}-title`}>{group.title}</h3><span>{group.players.length} players</span></div><div class="table-shell roster-shell" tabindex="0" role="region" aria-label={group.caption}><table class="roster-table"><caption class="sr-only">{group.caption}</caption><thead><tr><th scope="col">Player</th><th scope="col">Number</th><th scope="col">Position</th><th scope="col">Roster status</th><th scope="col">Latest verified update</th></tr></thead><tbody>{group.players.map((p) => <tr data-roster-row data-name={p.name.toLowerCase()} data-number={String(p.number)} data-position={p.position}><td class="player-cell"><a href={`/players/${encodeURIComponent(p.id)}`}><span class="number-mark">{p.number}</span><strong>{p.name}</strong></a></td><td data-label="Number">#{p.number}</td><td data-label="Position"><span class="position-mark">{p.position}</span></td><td data-label="Roster status"><span class="status-mark">{p.status}</span></td><td data-label="Latest update">{p.update ? `${p.update.status || p.update.transactionType} · ${p.update.updateStatus}` : "No status update listed"}</td></tr>)}</tbody></table></div></section>)}</div>
    <p class="empty-state" id="roster-empty" hidden>No current players match those filters.</p>
  </section>

  <section class="utility-section statistics-section" aria-labelledby="statistics-title">
    <div class="section-heading"><div><p class="eyebrow">Historical player statistics</p><h2 id="statistics-title">{statsContext.label} Player Statistics</h2><p>These totals describe the {statsSeason} regular season—not the {rosterStore.season} roster season.</p></div></div>
    <SeasonContextView context={statsContext} options={[statsContext]} prefix="Data through" />
    {leaders.length > 0 && <div class="leader-strip" aria-label={`${statsSeason} team leaders`}>{leaders.map((l) => <a href={`/players/${encodeURIComponent(String(pid(l.row)))}`}><span>{l.label}</span><strong>{l.stat}</strong><small>{l.metric}</small><b>{pname(l.row)}</b></a>)}</div>}
    {categories.length ? <><div class="stat-tabs" role="tablist" aria-label="Statistics category">{categories.map((c,i) => <button id={`tab-${c.id}`} role="tab" aria-selected={i===0?"true":"false"} aria-controls={`panel-${c.id}`} tabindex={i===0?0:-1}>{c.label}</button>)}</div>{categories.map((c,i) => <div id={`panel-${c.id}`} class="stat-panel" role="tabpanel" aria-labelledby={`tab-${c.id}`} hidden={i!==0}><div class="stat-panel-heading"><h3>{c.label}</h3><p>{c.rows.length} qualifying players · sorted by primary metric</p></div><div class="table-shell" tabindex="0" role="region" aria-label={`${statsSeason} ${c.label.toLowerCase()} statistics`}><table class="stats-table"><caption class="sr-only">Seattle {Team} {statsContext.label} {c.label.toLowerCase()} statistics</caption><thead><tr><th scope="col">Player</th><th scope="col">Position</th>{c.cols.map(([label]) => <th scope="col">{label}</th>)}</tr></thead><tbody>{c.rows.map((r) => <tr><td class="player-cell"><a href={`/players/${encodeURIComponent(String(pid(r)))}`}><strong>{pname(r)}</strong></a></td><td data-label="Position">{ppos(r)}</td>{c.cols.map(([label,keys]) => <td data-label={label}>{value(r,keys) ?? "—"}</td>)}</tr>)}</tbody></table></div></div>)}</> : <p class="empty-state">No verified player statistics are available for {statsContext.label}.</p>}
    <div class="interpretation"><div><p class="eyebrow">How to read this</p><h3>Roster and results answer different questions</h3></div><p>The directory reflects current club membership at the roster timestamp. Leaderboards preserve the season attached to the performance source, so offseason roster changes do not relabel past production.</p></div>
  </section>
  <p class="source-line">Roster source: <a href={rosterStore.sourceUrl}>Seattle {Team} official roster</a> · Snapshot {rosterDate}. Statistics: existing site season feed · <a href="/methodology">Methodology and update policy</a>.</p>
  <ContinueFanZone groups={[{title:"Team status",links:[{href:"/team/injuries",label:"Injuries"},{href:"/team/transactions",label:"Transactions"}]},{title:"Season context",links:[{href:"/team",label:"Team statistics"},{href:"/schedule",label:`${rosterStore.season} schedule`}]}]} />
  <script is:inline>
    (()=>{const rows=[...document.querySelectorAll('[data-roster-row]')],search=document.getElementById('roster-search'),position=document.getElementById('roster-position'),status=document.getElementById('roster-count'),empty=document.getElementById('roster-empty');function filter(){const q=(search?.value||'').trim().toLowerCase(),p=position?.value||'ALL';let shown=0;rows.forEach(row=>{row.hidden=!((p==='ALL'||row.dataset.position===p)&&(!q||row.dataset.name.includes(q)||row.dataset.number===q.replace(/^#/,'')));if(!row.hidden)shown++});if(status)status.innerHTML=`<strong>${shown}</strong> shown`;if(empty)empty.hidden=shown!==0}search?.addEventListener('input',filter);position?.addEventListener('change',filter);const tabs=[...document.querySelectorAll('[role="tab"]')];function activate(selected){tabs.forEach(tab=>{const on=tab===selected;tab.setAttribute('aria-selected',String(on));tab.tabIndex=on?0:-1;document.getElementById(tab.getAttribute('aria-controls')).hidden=!on})}tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>activate(tab));tab.addEventListener('keydown',event=>{if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;event.preventDefault();const next=event.key==='Home'?0:event.key==='End'?tabs.length-1:(index+(event.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;activate(tabs[next]);tabs[next].focus()})})})();
  </script>
  <style>
    .sr-only{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0)}.eyebrow{margin:0 0 .25rem;color:#398000;font-size:.7rem;font-weight:950;letter-spacing:.12em;text-transform:uppercase}.roster-intro{display:flex;justify-content:space-between;gap:1rem;align-items:center;padding:1.15rem 1.25rem;border-top:5px solid var(--action-green);background:var(--navy-950);color:#fff}.roster-intro h2,.roster-intro p{margin:.1rem 0}.context-badge{display:grid;min-width:150px;padding:.7rem .9rem;border:1px solid #ffffff47;background:#ffffff12}.context-badge span,.context-badge small{font-size:.72rem}.context-badge strong{font-size:1.65rem;color:#69be28}.utility-section{margin-top:1rem;padding:1rem;border:var(--border-crisp);background:#fff}.section-heading{display:flex;justify-content:space-between;gap:1rem;align-items:end}.section-heading h2,.section-heading p{margin:.15rem 0}.section-heading>div>p:last-child{max-width:62ch;color:var(--slate-700);font-size:.84rem}.filters{display:flex;gap:.65rem;flex-wrap:wrap;margin:.9rem 0}.filters label{display:grid;gap:.25rem;color:var(--slate-700);font-size:.7rem;font-weight:950;text-transform:uppercase}.filters input,.filters select{min-height:44px;padding:.5rem .65rem;border:2px solid var(--slate-500);background:#fff;color:var(--navy-950);font:800 .85rem inherit}.filters input{min-width:240px}.roster-group+.roster-group{margin-top:1.2rem}.roster-group-heading{display:flex;justify-content:space-between;align-items:baseline;padding:.55rem .7rem;border-left:4px solid var(--action-green);background:var(--navy-900);color:#fff}.roster-group-heading h3{margin:0;font-size:1rem}.roster-group-heading span{font-size:.72rem;font-weight:900}.table-shell{overflow:auto;border:1px solid var(--slate-300)}table{width:100%;border-collapse:collapse;font-size:.82rem}th,td{padding:.68rem .7rem;border-bottom:1px solid var(--slate-300);text-align:left;vertical-align:middle}th{background:var(--slate-100);color:var(--navy-900);font-size:.68rem;letter-spacing:.035em;text-transform:uppercase;white-space:nowrap}tbody tr:hover{background:#f7fafc}.player-cell a{display:flex;gap:.6rem;align-items:center;color:var(--navy-900);text-decoration:none}.player-cell a:hover{text-decoration:underline}.number-mark{display:grid;place-items:center;flex:0 0 36px;height:36px;border-radius:50%;background:var(--navy-900);color:#fff;font-weight:950}.position-mark,.status-mark{display:inline-block;padding:.22rem .4rem;background:var(--slate-100);font-weight:900}.status-mark{border-left:3px solid var(--action-green)}.source-line a{color:#2f660b;font-weight:900}.statistics-section :global(.season-context){margin:.75rem 0}.leader-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem;margin:.8rem 0}.leader-strip a{display:grid;grid-template-columns:1fr auto;padding:.7rem;border-top:4px solid var(--action-green);background:var(--slate-100);color:var(--navy-900);text-decoration:none}.leader-strip strong{font-size:1.35rem}.leader-strip small{text-align:right;font-size:.62rem}.leader-strip b{grid-column:1/-1;font-size:.73rem}.stat-tabs{display:flex;gap:.25rem;overflow:auto;border-bottom:2px solid var(--navy-800)}.stat-tabs button{min-height:44px;padding:.55rem .8rem;border:0;background:#fff;color:var(--navy-900);font-weight:950;white-space:nowrap;cursor:pointer}.stat-tabs button[aria-selected="true"]{background:var(--navy-800);color:#fff;box-shadow:inset 0 -4px var(--action-green)}.stat-panel{padding-top:.7rem}.stat-panel-heading{display:flex;justify-content:space-between;gap:1rem;align-items:baseline}.stat-panel-heading h3,.stat-panel-heading p{margin:.15rem 0}.stat-panel-heading p{color:var(--slate-700);font-size:.72rem}.stats-table th:not(:first-child),.stats-table td:not(:first-child){text-align:right;font-variant-numeric:tabular-nums}.stats-table .player-cell{min-width:180px;text-align:left}.interpretation{display:grid;grid-template-columns:minmax(180px,.45fr) 1fr;gap:1rem;margin-top:1rem;padding:1rem;border-left:5px solid var(--action-green);background:var(--slate-100)}.interpretation h3,.interpretation p{margin:.1rem 0}.source-line{color:var(--slate-700);font-size:.72rem}.empty-state{padding:1rem;background:var(--slate-100);text-align:center;font-weight:850}[hidden]{display:none!important}:is(button,input,select,a,.table-shell):focus-visible{outline:3px solid var(--action-green);outline-offset:2px}
    @media(max-width:800px){.leader-strip{grid-template-columns:repeat(2,minmax(0,1fr))}.interpretation{grid-template-columns:1fr}.stats-table{min-width:650px}}@media(max-width:620px){.roster-intro,.section-heading,.stat-panel-heading{align-items:stretch;flex-direction:column}.context-badge{min-width:0}.filters{display:grid;grid-template-columns:1fr 1fr}.filters input,.filters select{box-sizing:border-box;width:100%;min-width:0}.roster-shell{overflow:visible;border:0}.roster-table,.roster-table tbody{display:block}.roster-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.roster-table tbody{display:grid;gap:.55rem}.roster-table tr{display:grid;grid-template-columns:1fr 1fr;gap:.4rem .8rem;padding:.75rem;border:1px solid var(--slate-300)}.roster-table td{display:flex;justify-content:space-between;gap:.5rem;padding:.12rem 0;border:0}.roster-table td::before{content:attr(data-label);color:var(--slate-700);font-size:.66rem;font-weight:900;text-transform:uppercase}.roster-table .player-cell{grid-column:1/-1;padding-bottom:.5rem;border-bottom:1px solid var(--slate-300)}.roster-table .player-cell::before{display:none}.roster-table td:last-child{grid-column:1/-1}.leader-strip{grid-template-columns:1fr 1fr}}
  </style>
</{Team}Layout>
