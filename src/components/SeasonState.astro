---
interface Props {
  title: string;
  explanation: string;
  actionHref: string;
  actionLabel: string;
  priorHref?: string;
  priorLabel?: string;
  icon?: string;
}

const {
  title,
  explanation,
  actionHref,
  actionLabel,
  priorHref,
  priorLabel,
  icon = "12",
} = Astro.props;
---

<aside class="season-state" aria-label={title}>
  <span class="season-state__icon" aria-hidden="true">{icon}</span>
  <div>
    <strong>{title}</strong>
    <p>{explanation}</p>
    <nav aria-label={`${title} actions`}>
      <a href={actionHref}>{actionLabel} →</a>
      {priorHref && priorLabel && <a href={priorHref}>{priorLabel} →</a>}
    </nav>
  </div>
</aside>

<style>
  .season-state{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.8rem;align-items:start;padding:1rem;border:1px solid var(--slate-300);border-left:5px solid var(--action-green);background:var(--slate-100);color:var(--navy-900)}
  .season-state__icon{display:grid;width:2.25rem;height:2.25rem;place-items:center;border-radius:50%;background:var(--navy-900);color:var(--action-green);font:900 .78rem var(--font-display)}
  strong{display:block;font:900 1.05rem var(--font-display)}p{max-width:68ch;margin:.25rem 0 .5rem;color:var(--slate-700);line-height:1.5}nav{display:flex;gap:.45rem 1rem;flex-wrap:wrap}a{color:var(--color-action,#2f660b);font-weight:900}
  @media(max-width:420px){.season-state{grid-template-columns:1fr}.season-state__icon{width:2rem;height:2rem}}
</style>
