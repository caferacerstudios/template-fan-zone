import {validateEventSpyMirror} from "../lib/tickets/eventspy-mirror-schema.mjs";
import {chartPath,providerChartPoints} from "../lib/tickets/chart-path.mjs";
import {currentProviderQuotes,quoteAtSevenDayLow,relativeObservationAge} from "../lib/tickets/provider-quotes.mjs";
import {formatPacificCalendarDate} from "../lib/schedule.mjs";
const names={vividseats:"Vivid Seats",stubhub:"StubHub",ticketmaster:"Ticketmaster",seatgeek:"SeatGeek"},order=["ticketmaster","stubhub","vividseats","seatgeek"],colors={ticketmaster:"#165dff",stubhub:"#6f2dbd",vividseats:"#d81b70",seatgeek:"#d6472f"},root=document.querySelector("#ticket-price-explorer"),gameModels=JSON.parse(document.querySelector("#ticket-game-models")?.textContent||"{}"),money=c=>new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(c/100),esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])),date=s=>formatPacificCalendarDate(s,{weekday:"short",month:"short",day:"numeric",year:"numeric"}),seen=s=>new Intl.DateTimeFormat("en-US",{month:"short",day:"numeric",timeZone:"America/Los_Angeles"}).format(new Date(s)),checked=s=>{const parts=Object.fromEntries(new Intl.DateTimeFormat("en-US",{month:"short",day:"numeric",year:"numeric",hour:"numeric",minute:"2-digit",timeZone:"America/Los_Angeles",timeZoneName:"short"}).formatToParts(new Date(s)).map(({type,value})=>[type,value]));return`${parts.month} ${parts.day}, ${parts.year} at ${parts.hour}:${parts.minute} ${parts.dayPeriod} ${parts.timeZoneName}`},checkedTime=s=>`<time data-last-checked datetime="${esc(s)}">${esc(checked(s))}</time>`;
const picker=gameId=>`<div class="game-picker"><label for="{team}-game">Choose a {Team} game</label><select id="{team}-game" data-game-selector>${EVENTSPY_COVERAGE.map(row=>{const canonical=gameModels[row.gameId]?.game,displayDate=canonical?canonical.startsAt??canonical.date:row.localDate;return`<option value="${row.gameId}"${row.gameId===gameId?" selected":""}>${row.homeAway==="home"?"vs.":"at"} ${esc(row.opponent)} — ${displayDate?date(displayDate):"Week 18 · date TBD"}</option>`}).join("")}</select></div>`;
const teamLogo=abbr=>`/images/nfl/teams/${esc(abbr)}.png`;
function hero(g,v){const event=v?.event,dateValue=g.game?.startsAt??g.game?.date,time=g.game?.timeConfirmed&&g.game?.startsAt?new Intl.DateTimeFormat("en-US",{hour:"numeric",minute:"2-digit",timeZone:"America/Los_Angeles"}).format(new Date(g.game.startsAt))+" PT":null,kickoff=dateValue?`${date(dateValue)}${time?` · ${esc(time)}`:""}`:"Kickoff to be announced",seaValue=g.completed?`<b>${g.seaScore??"—"}</b>`:"",oppValue=g.completed?`<b>${g.opponentScore??"—"}</b>`:"";return`<header class="game-hero" data-game-hero><div class="hero-top"><span>${esc(g.weekLabel)}</span><span>${g.completed?`Final${g.outcome?` · ${g.outcome}`:""}`:`${g.home?"{Location} home game":"{Location} away game"}`}</span></div><div class="hero-teams"><div class="hero-team"><img src="${esc(g.{team}Logo||teamLogo("{Abbreviation}"))}" alt="{Location} {Team} logo" width="86" height="86"><strong>{Location} {Team}</strong>${seaValue}<small>${g.home?"Home":"Away"}</small></div><span class="hero-vs">${g.completed?"Final":g.home?"vs":"at"}</span><div class="hero-team hero-opponent"><img src="${esc(g.opponentLogo||teamLogo(g.opponentAbbr))}" alt="${esc(g.opponentName)} logo" width="86" height="86"><strong>${esc(g.opponentName)}</strong>${oppValue}<small>${g.home?"Away":"Home"}</small></div></div><div class="hero-details"><span>${kickoff}</span>${(event?.venue||g.venue)?`<span>${esc(event?.venue||g.venue)}</span>`:""}<span>${g.home?"Home":"Away"}</span></div></header>`}
function gameDetails(g,v){if(root.dataset.routeStyle==="games")return"";const href=id=>`/games/${encodeURIComponent(id)}/`,recap=g.completed&&g.recap?.text?`<section class="detail-panel recap-panel"><h2>Game Recap</h2><p>${esc(g.recap.text)}</p>${g.recap.bullets?.length?`<ul>${g.recap.bullets.map(item=>`<li>${esc(item)}</li>`).join("")}</ul>`:""}</section>`:"",watch=g.game?.network||g.game?.radio?`<section class="detail-panel"><h2>Where to watch and listen</h2>${g.game.network?`<p><strong>TV:</strong> ${esc(g.game.network)}</p>`:""}${g.game.radio?`<p><strong>Radio:</strong> ${esc(g.game.radio)}</p>`:""}</section>`:"";return`${recap}${watch}<nav class="game-nav" aria-label="Game navigation">${g.previousId?`<a href="${href(g.previousId)}">← Previous game</a>`:"<span>First tracked game</span>"}<a class="schedule" href="/schedule">Full schedule</a>${g.nextId?`<a class="next" href="${href(g.nextId)}">Next game →</a>`:'<span class="next">Last tracked game</span>'}</nav>`}
function unavailable(row){const g=gameModels[row.gameId];return`${picker(row.gameId)}${g?hero(g,null):""}<div class="unavailable" role="status"><h2>Ticket tracking unavailable</h2><p>Ticket tracking is not available for this game yet.</p></div>${g?gameDetails(g,null):""}`}
function providerCards(v,quotes){return quotes.map(quote=>`<a class="provider-card" data-provider="${quote.provider}" data-provider-price="${quote.priceCents??"unavailable"}" data-provider-rank="${quote.rank}" data-provider-observed-at="${quote.observedAt??""}" data-lowest-price="${quote.isLowest}" href="${esc(v.providerLinks[quote.provider])}" target="_blank" rel="nofollow noopener"><span class="provider-external" aria-hidden="true">↗</span><span class="provider-name">${names[quote.provider]}</span><span class="provider-label">Current lowest</span><span class="provider-price">${quote.priceCents===null?"Price unavailable":money(quote.priceCents)}</span>${quote.observedAt?`<span class="provider-age">Observed ${seen(quote.observedAt)}</span>`:""}${quote.isLowest?`<span class="low-badge">${quote.isTiedLowest?"Tied for lowest price":"Lowest price"}</span>`:""}</a>`).join("")}
function content(v){const now=Date.now(),stale=now-Date.parse(v.collectedAt)>26*3600e3,g=gameModels[v.gameId],quotes=currentProviderQuotes(v.history),winner=quotes.find(quote=>quote.isLowest)??null,currentLowest=winner?.priceCents??null,currentPrice=currentLowest===null?"Price unavailable":money(currentLowest),currentAge=winner?.observedAt?relativeObservationAge(winner.observedAt,now):null,atSevenDayLow=quoteAtSevenDayLow(v.history,winner,now);return`${picker(v.gameId)}${stale?`<p class="stale" role="status">Prices have not been refreshed recently. Last checked ${checkedTime(v.collectedAt)}.</p>`:""}${g?hero(g,v):""}${g?.completed?'<p class="historical-note">Historical ticket-market information for this completed game.</p>':""}<div class="cards"><article class="card"><h2>${g?.completed?"Game status":"Days Until Kickoff"}</h2><p class="days" data-days-until>${g?.completed?"Final":v.summary.daysUntilEvent}</p></article><article class="card current-lowest"><h2>${g?.completed?"Historical Lowest":"Current Lowest"}</h2><p class="price current" data-current-lowest="${currentLowest??"unavailable"}">${currentPrice}</p>${currentAge?`<p class="age">Observed ${esc(currentAge)}</p>`:""}${atSevenDayLow?'<span class="low-badge">At 7-day low</span>':""}</article><article class="card"><h2>Last checked</h2><p class="age">${checkedTime(v.collectedAt)}</p></article></div><h2 class="providers-title">${g?.completed?"Historical Provider Comparison":"Compare Ticket Providers"}</h2><div class="providers">${providerCards(v,quotes)}</div><section class="history-panel"><div class="history-top"><div><h2>Lowest Ticket Price History</h2><p class="subtitle">Compare displayed lowest prices across four marketplaces.</p></div><div class="controls" aria-label="Price history controls"><button type="button" data-range="30" aria-label="Show 30 days" aria-pressed="false">30d</button><button type="button" data-range="14" aria-label="Show 14 days" aria-pressed="false">14d</button><button type="button" data-range="7" aria-label="Show 7 days" aria-pressed="true">7d</button><label for="market-view">Marketplace view</label><select id="market-view" data-market-selector><option value="combined">Combined</option>${order.map(m=>`<option value="${m}">${names[m]}</option>`).join("")}</select></div></div><ul class="legend" aria-label="Marketplace line colors">${order.map(m=>`<li><span class="legend-swatch" style="--c:${colors[m]}" aria-hidden="true"></span>${names[m]}</li>`).join("")}</ul><p class="chart-note" id="price-history-note">Lines connect the nearest available price observations. Missing provider updates remain blank in the data table.</p><div class="chart-wrap"><svg class="chart" viewBox="0 0 1000 390" role="img" aria-label="Lowest ticket price history" aria-describedby="price-history-note" data-history-chart></svg></div><details><summary>Accessible price history table</summary><div class="table-wrap"><table><caption>Displayed ticket price history in USD</caption><thead><tr><th scope="col">Date</th>${order.map(m=>`<th scope="col">${names[m]}</th>`).join("")}</tr></thead><tbody></tbody></table></div></details></section>${g?gameDetails(g,v):""}`}
function renderChart(v,days=7,selected="combined"){const svg=root.querySelector("[data-history-chart]"),end=Date.parse(v.history.at(-1).observedAt),points=v.history.filter(p=>Date.parse(p.observedAt)>=end-days*864e5),shown=selected==="combined"?order:[selected],values=points.flatMap(p=>shown.map(m=>p[`${m}Cents`])).filter(Number.isSafeInteger);svg.setAttribute("aria-label",`Lowest ticket price history for the last ${days} days, ${selected==="combined"?"combined marketplace view":`${names[selected]} view`}`);if(!values.length){svg.replaceChildren();return}const lo=Math.min(...values),hi=Math.max(...values),W=1000,H=390,L=85,R=25,T=20,B=45,x=i=>points.length<2?(W+L-R)/2:L+i/(points.length-1)*(W-L-R),y=n=>T+(hi-n)/Math.max(1,hi-lo)*(H-T-B),ns="http://www.w3.org/2000/svg";svg.replaceChildren();for(let i=0;i<5;i++){const yy=T+i*(H-T-B)/4,line=document.createElementNS(ns,"line"),label=document.createElementNS(ns,"text"),val=Math.round(hi-i*(hi-lo)/4);for(const[k,z]of Object.entries({x1:L,x2:W-R,y1:yy,y2:yy}))line.setAttribute(k,z);line.setAttribute("class","grid");label.setAttribute("x","4");label.setAttribute("y",yy+4);label.setAttribute("class","axis");label.textContent=money(val);svg.append(line,label)}const dateIndexes=[0,Math.floor((points.length-1)/2),points.length-1].filter((index,pos,list)=>index>=0&&list.indexOf(index)===pos);for(const index of dateIndexes){const label=document.createElementNS(ns,"text");label.setAttribute("x",x(index));label.setAttribute("y",H-13);label.setAttribute("class","axis date");label.textContent=seen(points[index].observedAt);svg.append(label)}for(const m of order){const group=document.createElementNS(ns,"g");group.dataset.historySeries=m;group.style.display=shown.includes(m)?"":"none";const providerPoints=providerChartPoints(points,m,x,y),last=providerPoints.at(-1);if(providerPoints.length>=2){const path=document.createElementNS(ns,"path");path.setAttribute("d",chartPath(providerPoints));path.setAttribute("stroke",colors[m]);path.setAttribute("class","series");group.append(path)}if(last){const circle=document.createElementNS(ns,"circle");for(const[k,z]of Object.entries({cx:last.x,cy:last.y,r:6,fill:colors[m]}))circle.setAttribute(k,z);circle.setAttribute("class","endpoint");group.append(circle)}svg.append(group)}root.querySelector("tbody").innerHTML=points.map(p=>`<tr><th>${seen(p.observedAt)}</th>${order.map(m=>`<td>${p[`${m}Cents`]===null?"—":money(p[`${m}Cents`])}</td>`).join("")}</tr>`).join("");svg.dataset.visiblePoints=String(points.length)}
function navigate(gameId){const url=root.dataset.routeStyle==="games"?new URL(`/games/${encodeURIComponent(gameId)}/`,location.origin):new URL(`/tickets/?game=${encodeURIComponent(gameId)}`,location.origin);history.pushState({},"",url);load(gameId)}
function bindPicker(){const selector=root.querySelector("[data-game-selector]");if(selector)selector.onchange=event=>navigate(event.target.value)}
function activate(v){bindPicker();const currentLowest=root.querySelector("[data-current-lowest]")?.dataset.currentLowest??"unavailable",requestedRange=Number(new URLSearchParams(location.search).get("range"));let days=[7,14,30].includes(requestedRange)?requestedRange:7,selected="combined";root.querySelectorAll("[data-range]").forEach(button=>{button.setAttribute("aria-pressed",String(Number(button.dataset.range)===days));button.onclick=()=>{days=Number(button.dataset.range);root.querySelectorAll("[data-range]").forEach(other=>other.setAttribute("aria-pressed",String(other===button)));renderChart(v,days,selected)}});const disclosure=document.createElement("p");disclosure.className="disclosure";disclosure.textContent="{Team} Fan Zone may earn a commission from links marked “Affiliate link” and does not sell tickets.";root.querySelector(".providers-title")?.after(disclosure);if(root.dataset.routeStyle==="games")root.querySelectorAll(":scope > .game-details, :scope > .game-nav, :scope > .recap-panel").forEach(element=>element.remove());root.querySelector("[data-market-selector]").onchange=event=>{selected=event.target.value;renderChart(v,days,selected)};renderChart(v,days,selected);Object.assign(root.dataset,{ticketPageReady:"true",gameId:v.gameId,historyPoints:String(v.history.length),providerLinks:"4",currentLowestCents:currentLowest,sevenDayLowestCents:String(v.summary.sevenDayLowestCents),collectedAt:v.collectedAt,historyRange:String(days)})}
async function load(requested){root.setAttribute("aria-busy","true");const queryId=new URLSearchParams(location.search).get("game"),requestedId=requested??(root.dataset.routeStyle==="tickets"?queryId:null)??root.dataset.initialGameId??EVENTSPY_COVERAGE[0].gameId,row=eventSpyCoverageForGame(requestedId);if(!row){const g=gameModels[requestedId];root.innerHTML=`${picker("")}${g?hero(g,null):""}<div class="unavailable" role="status"><p>Ticket tracking is not available for this game yet.</p></div>${g?gameDetails(g,null):""}`;bindPicker();root.setAttribute("aria-busy","false");return}const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),8000);try{const response=await fetch(eventSpyMirrorUrl(row.gameId),{cache:"no-store",headers:{accept:"application/json"},signal:controller.signal});if(!response.ok)throw Error();const value=validateEventSpyMirror(await response.json());if(value.state==="unavailable"){root.innerHTML=unavailable(row);bindPicker()}else{root.innerHTML=content(value);activate(value)}}catch{const g=gameModels[row.gameId];root.innerHTML=`${picker(row.gameId)}${g?hero(g,null):""}<div class="unavailable" role="status"><p>Ticket tracking is not available for this game yet.</p></div>${g?gameDetails(g,null):""}`;bindPicker()}finally{clearTimeout(timer);root.setAttribute("aria-busy","false")}}
if(root){addEventListener("popstate",()=>load());load()}
</script>
