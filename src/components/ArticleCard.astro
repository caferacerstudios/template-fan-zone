---
import type { NewsArticle } from "../lib/news";
import ResponsiveImage from "./ResponsiveImage.astro";
import { articleReadingMinutes, categorySlug, formatArticleDate, materiallyUpdated } from "../lib/news";

interface Props { article: NewsArticle; prominent?: boolean; }
const { article, prominent = false } = Astro.props;
const readingMinutes = articleReadingMinutes(article);
const updated = materiallyUpdated(article);
---
<article class:list={["news-card", { "news-card--prominent": prominent }]} data-news-card data-search={`${article.headline} ${article.dek} ${article.category} ${article.tags.join(" ")}`.toLowerCase()}>
  <a class="news-card__image" href={`/news/${article.slug}/`} aria-label={`Read: ${article.headline}`} tabindex="-1">
    <ResponsiveImage src={article.hero.src} alt={article.hero.alt} width={article.hero.width} height={article.hero.height} sizes={prominent ? "(max-width: 680px) 100vw, 60vw" : "(max-width: 620px) 100vw, 50vw"} priority={prominent} />
  </a>
  <div class="news-card__body">
    <a class="news-card__category" href={`/news/category/${categorySlug(article.category)}/`}>{article.category}</a>
    <h3><a href={`/news/${article.slug}/`}>{article.headline}</a></h3>
    <p>{article.dek}</p>
    <div class="news-card__meta"><span>{prominent && <>By {article.author} · </>}{updated ? "Updated" : "Published"} <time datetime={updated ? article.updatedAt : article.publishedAt}>{formatArticleDate(updated ? article.updatedAt : article.publishedAt)}</time></span><span>{readingMinutes} min read</span></div>
  </div>
</article>
<style>
  .news-card{overflow:hidden;border-bottom:1px solid #c7d1d6;background:#fff}.news-card__image{display:block;overflow:hidden;background:var(--slate-100)}.news-card__image :global(picture){display:block}.news-card__image :global(img){display:block;width:100%;aspect-ratio:16/9;object-fit:cover;transition:transform .2s ease}.news-card:focus-within .news-card__image :global(img),.news-card:hover .news-card__image :global(img){transform:scale(1.015)}.news-card__body{padding:1rem 0}.news-card__category{position:relative;color:#386f13;font:900 .72rem var(--font-display);letter-spacing:.08em;text-transform:uppercase}.news-card h3{margin:.4rem 0;font:900 clamp(1.35rem,2.5vw,1.65rem)/1.05 var(--font-display)}.news-card h3 a{color:var(--navy-900);text-decoration:none}.news-card h3 a:hover{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:3px}.news-card p{margin:.6rem 0;color:var(--slate-700);line-height:1.5}.news-card__meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.25rem 1rem;padding-top:.65rem;border-top:1px solid #d8dfe3;color:var(--slate-700);font-size:.75rem}.news-card--prominent{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,1fr);border:0;background:var(--navy-950)}.news-card--prominent .news-card__image,.news-card--prominent .news-card__image :global(picture),.news-card--prominent .news-card__image :global(img){height:100%}.news-card--prominent .news-card__image :global(img){min-height:320px}.news-card--prominent .news-card__body{display:flex;flex-direction:column;justify-content:center;padding:clamp(1.2rem,4vw,2.2rem)}.news-card--prominent h3{font-size:clamp(2rem,5vw,3.5rem)}.news-card--prominent h3 a,.news-card--prominent p{color:#fff}.news-card--prominent .news-card__meta{color:var(--slate-300);border-color:#ffffff30}@media(max-width:680px){.news-card--prominent{grid-template-columns:1fr}.news-card--prominent .news-card__image :global(img){min-height:0;aspect-ratio:16/9}}
  .news-card:not(.news-card--prominent) .news-card__image{aspect-ratio:16/9}
  .news-card:not(.news-card--prominent) .news-card__image :global(picture),.news-card:not(.news-card--prominent) .news-card__image :global(img){width:100%;height:100%}
</style>
