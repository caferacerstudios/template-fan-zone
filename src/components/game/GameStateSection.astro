---
import rosterData from "../../data/nfl/players.json";
import currentRosterData from "../../data/team/roster.json";
import seasonData from "../../data/nfl/{team}.json";
import { readPlayerProfiles } from "../../lib/player-profiles.mjs";
import { playerRouteRegistry, recapRenderParts } from "../../lib/recap-player-links.mjs";
const { game, presentation } = Astro.props;
const recap = game?.recap ?? null;
const recapText = recap?.text ?? recap?.summary ?? recap?.excerpt ?? null;
const segments = Array.isArray(recap?.segments) ? recap.segments : [];
const bullets = Array.isArray(recap?.bullets) ? recap.bullets : [];
const hasRecap = Boolean(String(recapText ?? "").trim() || segments.length || bullets.length);
const score = presentation.{team}Score != null && presentation.opponentScore != null
  ? `Seattle {Team} ${presentation.{team}Score}, ${game.opponentName} ${presentation.opponentScore}` : "Score unavailable";
const gameClock = [presentation.quarter, presentation.clock].filter(Boolean).join(" · ");
const roster = Array.isArray(rosterData?.playerSeasonStats) ? rosterData.playerSeasonStats
  : Array.isArray(rosterData?.data) ? rosterData.data
  : Array.isArray(rosterData?.players) ? rosterData.players
  : [];
const profiles = readPlayerProfiles().data?.profiles ?? {};
const profileRecords = Object.entries(profiles).map(([id, profile]) => ({ id, name:profile?.name ?? profile?.full_name }));
const playerRegistry = playerRouteRegistry([...(currentRosterData?.players ?? []), ...roster, ...(seasonData?.playerSeasonStats ?? []), ...profileRecords]);
const renderParts = (value) => recapRenderParts(value, playerRegistry);
---

<section class={`game-state-panel game-state-${presentation.state}`} aria-labelledby="game-state-heading">
  <p class="state-label">{presentation.state === "completed" ? "Final" : "Live"}</p>
  <h2 id="game-state-heading">{presentation.state === "completed" ? "Final score and recap" : "Live game updates"}</h2>
  <p class="scoreboard"><strong>{score}</strong></p>
  {presentation.state === "in_progress" && gameClock && <p class="game-clock">{gameClock}</p>}

  {presentation.state === "in_progress" && (
    presentation.updates.length ? <ol class="game-updates">
      {presentation.updates.map((update) => <li>
        <p>{update.text}</p>
        {(update.quarter || update.clock) && <span>{[update.quarter, update.clock].filter(Boolean).join(" · ")}</span>}
      </li>)}
    </ol> : <p>Updates will appear here as they are added.</p>
  )}

  {presentation.state === "completed" && (hasRecap ? <div class="recap-content" id="recap">
    {recapText && <p>{renderParts(recapText).map((part) => part.href ? <a href={part.href}>{part.text}</a> : part.text)}</p>}
    {segments.length > 0 && <p>{renderParts(segments).map((part) => part.href ? <a href={part.href}>{part.text}</a> : part.text)}</p>}
    {bullets.length > 0 && <ul>{bullets.map((item) => <li>{renderParts(typeof item === "string" ? item : item?.text).map((part) => part.href ? <a href={part.href}>{part.text}</a> : part.text)}</li>)}</ul>}
    {recap?.url && <p><a href={recap.url}>Read the associated recap</a></p>}
  </div> : <p>Recap coming soon</p>)}
</section>

<style>
  .game-state-panel{--navy:#002244;--green:#69be28;--muted:#536171;--line:#d7dfe6;width:min(1160px,calc(100% - 3rem));margin:1.5rem auto;padding:clamp(1rem,3vw,1.5rem);background:#fff;border:1px solid var(--line);border-top:5px solid var(--green);border-radius:.8rem;color:#0b1f35}.state-label{margin:0 0 .25rem;color:#4b711f;font-size:.78rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.game-state-panel h2{margin:0 0 .75rem;color:var(--navy);font-size:clamp(1.35rem,3vw,1.8rem)}.scoreboard{margin:.5rem 0;font-size:clamp(1.35rem,4vw,2.25rem);font-variant-numeric:tabular-nums}.game-clock{color:var(--muted);font-weight:800}.game-updates{margin:1.25rem 0 0;padding:0;list-style:none}.game-updates li{padding:.85rem 0;border-top:1px solid var(--line)}.game-updates p{margin:0;line-height:1.55}.game-updates span{display:block;margin-top:.25rem;color:var(--muted);font-size:.82rem;font-weight:800}.recap-content p,.recap-content li{line-height:1.65}.recap-content ul{padding-left:1.25rem}@media(max-width:650px){.game-state-panel{width:calc(100% - 1.5rem)}}
</style>
