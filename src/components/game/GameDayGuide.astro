---
import GuideSourceLink from "./GuideSourceLink.astro";
const { guide = null } = Astro.props;
const populated = (value) => typeof value === "string" ? value.trim().length > 0 : Array.isArray(value) ? value.length > 0 : value !== null && value !== undefined;
const entries = (value, fields) => Array.isArray(value) ? value.filter((item) => item && typeof item === "object" && fields.some((field) => populated(item[field]))) : [];
const alerts = entries(guide?.alerts, ["title", "text"]);
const transportation = entries(guide?.transportation, ["name", "recommendation", "details"]);
const parking = entries(guide?.parking, ["name", "details"]);
const timeline = entries(guide?.timeline, ["time", "event", "details"]);
const tailgates = entries(guide?.tailgates, ["name", "location", "startTime", "description", "price", "ageRestriction"]);
const watchParties = entries(guide?.watchParties, ["name", "location", "startTime", "description", "specials", "ageRestriction"]);
const stadiumTips = entries(guide?.stadiumTips, ["title", "details"]);
const weather = guide?.weather && typeof guide.weather === "object" && [guide.weather.summary, guide.weather.temperature, guide.weather.precipitationChance, guide.weather.wind].some(populated) ? guide.weather : null;
const severity = (value) => ({ critical: { key:"critical", label:"Critical" }, warning: { key:"warning", label:"Important" }, info: { key:"info", label:"Info" } }[value] ?? { key:"info", label:"Info" });
const updated = populated(guide?.lastUpdated) && !Number.isNaN(Date.parse(guide.lastUpdated))
  ? new Intl.DateTimeFormat("en-US", { month:"long", day:"numeric", year:"numeric", hour:"numeric", minute:"2-digit", timeZoneName:"short", timeZone:"America/Los_Angeles" }).format(new Date(guide.lastUpdated))
  : null;
---
<section class="detail-panel game-day-guide" aria-labelledby="game-day-guide-heading">
  <header class="guide-header">
    <h2 id="game-day-guide-heading">Game Day Guide</h2>
    {guide && updated && <p class="guide-updated">Last updated <time datetime={guide.lastUpdated}>{updated}</time></p>}
  </header>
  {!guide ? <p>Game Day Guide coming soon.</p> : <details class="guide-disclosure">
    <summary>
      {populated(guide.summary) && <span class="guide-preview">{guide.summary}</span>}
      <span class="guide-toggle"><span class="show-label">View Game Day Guide</span><span class="hide-label">Hide Game Day Guide</span><span aria-hidden="true">⌄</span></span>
    </summary>
    <div class="guide-content">
    {populated(guide.summary) && <p class="guide-summary">{guide.summary}</p>}
    {alerts.length > 0 && <section class="guide-section alerts" aria-labelledby="guide-alerts"><h3 id="guide-alerts">Important Alerts</h3><ul class="guide-list">{alerts.map((item) => { const level = severity(item.severity); return <li class={`alert alert-${level.key}`}><p class="alert-label">{level.label}</p>{populated(item.title) && <h4>{item.title}</h4>}{populated(item.text) && <p>{item.text}</p>}<GuideSourceLink url={item.sourceUrl} /></li>; })}</ul></section>}
    {transportation.length > 0 && <section class="guide-section" aria-labelledby="guide-transportation"><h3 id="guide-transportation">Getting There</h3><ul class="guide-list">{transportation.map((item) => <li>{populated(item.name) && <h4>{item.name}</h4>}{populated(item.recommendation) && <p class="recommendation">{item.recommendation}</p>}{populated(item.details) && <p>{item.details}</p>}<GuideSourceLink url={item.sourceUrl} label="Transportation details" /></li>)}</ul></section>}
    {parking.length > 0 && <section class="guide-section" aria-labelledby="guide-parking"><h3 id="guide-parking">Parking</h3><ul class="guide-list">{parking.map((item) => <li>{populated(item.name) && <h4>{item.name}</h4>}{populated(item.details) && <p>{item.details}</p>}<GuideSourceLink url={item.sourceUrl} label="Parking details" /></li>)}</ul></section>}
    {timeline.length > 0 && <section class="guide-section" aria-labelledby="guide-timeline"><h3 id="guide-timeline">Game Day Timeline</h3><ol class="timeline">{timeline.map((item) => <li><p class="timeline-time">{item.time}</p><div>{populated(item.event) && <h4>{item.event}</h4>}{populated(item.details) && <p>{item.details}</p>}</div></li>)}</ol></section>}
    {tailgates.length > 0 && <section class="guide-section" aria-labelledby="guide-tailgates"><h3 id="guide-tailgates">Tailgates &amp; Pregame</h3><ul class="guide-grid two-column">{tailgates.map((item) => <li class="guide-card">{item.official === true && <p class="official-label">Official {Team} Event</p>}{populated(item.name) && <h4>{item.name}</h4>}{populated(item.location) && <p><strong>Location:</strong> {item.location}</p>}{populated(item.startTime) && <p><strong>Starts:</strong> {item.startTime}</p>}{populated(item.description) && <p>{item.description}</p>}{typeof item.price === "number" && <p><strong>Price:</strong> ${item.price}</p>}{populated(item.ageRestriction) && <p><strong>Age restriction:</strong> {item.ageRestriction}</p>}<GuideSourceLink url={item.sourceUrl} label="Event details" /></li>)}</ul></section>}
    {watchParties.length > 0 && <section class="guide-section" aria-labelledby="guide-watch-parties"><h3 id="guide-watch-parties">Watch Parties</h3><ul class="guide-grid two-column">{watchParties.map((item) => { const specials = Array.isArray(item.specials) ? item.specials.filter(populated) : []; return <li class="guide-card">{populated(item.name) && <h4>{item.name}</h4>}{populated(item.location) && <p><strong>Location:</strong> {item.location}</p>}{populated(item.startTime) && <p><strong>Starts:</strong> {item.startTime}</p>}{populated(item.description) && <p>{item.description}</p>}{specials.length > 0 && <div><h5>Specials</h5><ul class="specials">{specials.map((special) => <li>{special}</li>)}</ul></div>}{populated(item.ageRestriction) && <p><strong>Age restriction:</strong> {item.ageRestriction}</p>}<GuideSourceLink url={item.sourceUrl} label="Event details" /></li>; })}</ul></section>}
    {stadiumTips.length > 0 && <section class="guide-section" aria-labelledby="guide-stadium-tips"><h3 id="guide-stadium-tips">Stadium Tips</h3><ul class="guide-list">{stadiumTips.map((item) => <li>{populated(item.title) && <h4>{item.title}</h4>}{populated(item.details) && <p>{item.details}</p>}<GuideSourceLink url={item.sourceUrl} label="Official information" /></li>)}</ul></section>}
    {weather && <section class="guide-section" aria-labelledby="guide-weather"><h3 id="guide-weather">Weather</h3><div class="weather">{populated(weather.summary) && <p>{weather.summary}</p>}<dl>{populated(weather.temperature) && <div><dt>Temperature</dt><dd>{weather.temperature}</dd></div>}{populated(weather.precipitationChance) && <div><dt>Precipitation</dt><dd>{weather.precipitationChance}</dd></div>}{populated(weather.wind) && <div><dt>Wind</dt><dd>{weather.wind}</dd></div>}</dl><GuideSourceLink url={weather.sourceUrl} label="Forecast source" /></div></section>}
    </div>
  </details>}
</section>

<style>
  .guide-header{display:flex;align-items:baseline;justify-content:space-between;gap:.5rem .75rem;flex-wrap:wrap}.guide-header h2{margin-bottom:0}.guide-updated{margin:0!important;color:var(--muted);font-size:.72rem;font-weight:800;text-transform:uppercase}.guide-disclosure summary{display:block;cursor:pointer;list-style:none}.guide-disclosure summary::-webkit-details-marker{display:none}.guide-preview{display:-webkit-box;overflow:hidden;margin:.8rem 0;-webkit-box-orient:vertical;-webkit-line-clamp:3;color:var(--muted);font-size:.92rem;line-height:1.5}.guide-toggle{display:inline-flex;min-height:40px;align-items:center;gap:.45rem;padding:.4rem .7rem;border:2px solid var(--navy);border-radius:.3rem;background:var(--navy);color:#fff;font-size:.82rem;font-weight:900}.guide-toggle [aria-hidden]{font-size:1.05rem;transition:transform .15s ease}.hide-label{display:none}.guide-disclosure[open] .guide-preview,.guide-disclosure[open] .show-label{display:none}.guide-disclosure[open] .hide-label{display:inline}.guide-disclosure[open] .guide-toggle [aria-hidden]{transform:rotate(180deg)}.guide-content{margin-top:1rem;padding-top:.15rem;border-top:1px solid var(--line)}.guide-summary{margin:.8rem 0 0;font-size:.96rem}.guide-section{margin-top:1.25rem}.guide-section>h3{margin:0 0 .5rem;color:var(--navy);font-size:1.08rem}.guide-list{margin:0!important;padding:0!important;list-style:none}.guide-list>li{min-width:0;padding:.75rem 0;border-top:1px solid var(--line)}.guide-list>li:last-child{border-bottom:1px solid var(--line)}.guide-list h4,.guide-card h4{margin:0 0 .3rem;color:var(--navy);font-size:1rem}.guide-list p,.guide-card p{margin:.25rem 0!important}.guide-grid{display:grid;gap:.6rem;margin:0!important;padding:0!important;list-style:none}.guide-grid.two-column{grid-template-columns:repeat(2,minmax(0,1fr))}.guide-card{min-width:0;padding:.75rem;border:1px solid var(--line);border-radius:.45rem;background:var(--soft)}.guide-card h5{margin:.55rem 0 .2rem;font-size:.88rem}.recommendation{padding-left:.55rem;border-left:3px solid var(--green);font-weight:800}.alert{padding:.7rem .75rem!important;border-left:5px solid #4d718f;background:#f7f9fa}.alert-warning{border-left-color:#b36b00;background:#fffaf0}.alert-critical{border-left-color:#a61b1b;background:#fff5f5}.alert-label,.official-label{display:inline-block;margin:0 0 .35rem!important;padding:.15rem .4rem;border-radius:.25rem;background:#e8eef3;color:#173b5a;font-size:.7rem;font-weight:900;letter-spacing:.04em;text-transform:uppercase}.alert-warning .alert-label{background:#f7dfb8;color:#714100}.alert-critical .alert-label{background:#a61b1b;color:#fff}.official-label{background:#e4f3d8;color:#245f12}.timeline{margin:0;padding:0;list-style:none}.timeline li{display:grid;grid-template-columns:minmax(7rem,9rem) 1fr;gap:.75rem;padding:.65rem 0;border-top:1px solid var(--line)}.timeline li:last-child{border-bottom:1px solid var(--line)}.timeline-time{margin:0!important;color:var(--navy);font-weight:900}.timeline h4{margin:0;font-size:1rem}.timeline div p{margin:.15rem 0 0!important}.specials{margin:.2rem 0 0!important;padding-left:1.1rem!important}.weather>p{margin:.25rem 0!important}.weather dl{display:grid;gap:.35rem;margin:.65rem 0}.weather dl div{display:grid;grid-template-columns:minmax(7rem,9rem) 1fr;gap:.5rem;padding:.25rem 0;border-bottom:1px solid var(--line)}.weather dt{font-weight:900}.weather dd{margin:0}@media(max-width:900px){.guide-grid.two-column{grid-template-columns:1fr}}@media(max-width:700px){.timeline li{grid-template-columns:1fr;gap:.1rem}.weather dl div{grid-template-columns:1fr;gap:.05rem}}@media(max-width:600px){.game-day-guide{padding:1rem}.guide-preview{font-size:.9rem}.guide-summary{font-size:.93rem}}
</style>
