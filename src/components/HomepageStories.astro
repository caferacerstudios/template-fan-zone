---
import { coverageArticles, formatArticleDate, leadArticle } from "../lib/news";
import { DEFAULT_HOMEPAGE_FRESHNESS_DAYS, selectHomepageStories } from "../lib/homepage-feed";
const configuredDays = Number(import.meta.env.HOMEPAGE_STORY_FRESHNESS_DAYS);
const freshnessDays = Number.isFinite(configuredDays) && configuredDays > 0 ? configuredDays : DEFAULT_HOMEPAGE_FRESHNESS_DAYS;
const configuredNow = import.meta.env.HOMEPAGE_FEED_NOW;
const now = configuredNow && Number.isFinite(Date.parse(configuredNow)) ? new Date(configuredNow) : new Date();
const { stories, heading, hasRecentStories } = selectHomepageStories(coverageArticles, { now, freshnessDays, leadArticle });
const [lead, ...secondary] = stories;
const metadata = (story: (typeof stories)[number]) => [`${story.dateLabel} ${formatArticleDate(story.date)}`, story.external ? `Source: ${story.byline}` : `By ${story.byline}`, story.readMinutes ? `${story.readMinutes} min read` : null].filter(Boolean);
---
{lead && <section class="top-stories" aria-labelledby="top-stories-title" data-feed-state={hasRecentStories ? "current" : "archive"}>
  <header class="feed-heading"><div><p class="label">{Team} briefing</p><h2 id="top-stories-title">{heading}</h2></div><p>{hasRecentStories ? `Published or updated within ${freshnessDays} days, with editor-selected context.` : "Worth revisiting while the current news cycle is quiet."}</p></header>
  <article class="lead-story">
    <div class:list={["story-media", { "story-media--graphic": !lead.image }]}>{lead.image ? <img src={lead.image.src} alt={lead.image.alt} width={lead.image.width} height={lead.image.height} loading="eager" decoding="async" /> : <div aria-hidden="true"><strong>12</strong><span>{lead.category} · {Location}</span></div>}</div>
    <div class="story-body"><div class="story-flags"><span>{lead.category}</span>{lead.editorialLabel && <span class="editor-pick">{lead.editorialLabel}</span>}{lead.external && <span>External</span>}</div><h3><a href={lead.href} target={lead.external ? "_blank" : undefined} rel={lead.external ? "noopener noreferrer" : undefined}>{lead.headline}{lead.external && <><span class="external-mark" aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens publisher site in a new tab)</span></>}</a></h3><p class="summary">{lead.summary}</p><p class="story-meta">{metadata(lead).join(" · ")}</p></div>
  </article>
  {secondary.length > 0 && <div class="secondary-stories">{secondary.map((story) => <article class:list={["secondary-story", { external: story.external }]}><div class="story-context" aria-hidden="true"><span>{story.category.slice(0, 2)}</span></div><div class="secondary-story__body"><div class="story-flags"><span>{story.category}</span>{story.editorialLabel && <span class="editor-pick">{story.editorialLabel}</span>}{story.external && <span>External</span>}</div><h3><a href={story.href} target={story.external ? "_blank" : undefined} rel={story.external ? "noopener noreferrer" : undefined}>{story.headline}{story.external && <><span class="external-mark" aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens publisher site in a new tab)</span></>}</a></h3><p class="summary">{story.summary}</p><p class="story-meta">{metadata(story).join(" · ")}</p></div></article>)}</div>}
  <a class="more-news" href="/news">More {Team} news <span aria-hidden="true">→</span></a>
</section>}
<style>
  .top-stories{margin-top:1rem;padding:clamp(1rem,3vw,1.5rem);border-top:6px solid var(--action-green);background:#fff;box-shadow:var(--shadow-sm)}.feed-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1rem}.feed-heading h2{margin:.1rem 0 0;font-size:clamp(1.8rem,4vw,2.7rem);line-height:1}.feed-heading>p{max-width:340px!important;margin:0!important;color:var(--slate-700);font-size:.78rem;text-align:right}.lead-story{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(250px,1fr);min-height:320px;background:var(--navy-950);color:#fff}.lead-story img{width:100%;height:100%;min-height:320px;object-fit:cover}.story-body{display:flex;flex-direction:column;justify-content:center;padding:clamp(1.2rem,4vw,2rem)}.story-flags{display:flex;gap:.4rem;flex-wrap:wrap}.story-flags span{padding:.25rem .45rem;background:var(--navy-800);color:#fff;font:900 .62rem var(--font-display);letter-spacing:.07em;text-transform:uppercase}.story-flags .editor-pick{background:#dfe8d8;color:var(--navy-900)}.lead-story .story-flags span{background:#ffffff1f}.lead-story .story-flags .editor-pick{background:var(--action-green);color:var(--navy-950)}.lead-story h3{margin:.7rem 0;font:900 clamp(2rem,5vw,3.35rem)/.95 var(--font-display)}.lead-story h3 a{color:#fff;text-decoration:none}.summary{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2}.lead-story .summary{color:var(--slate-100)}.story-meta{margin-top:auto!important;padding-top:.75rem;border-top:1px solid #ffffff32;color:var(--slate-300);font-size:.72rem}.secondary-stories{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;margin-top:1px;background:#c5d0d6}.secondary-story{display:flex;min-width:0;flex-direction:column;padding:1rem;background:#f7f9fa;border-top:4px solid var(--navy-800)}.secondary-story.external{border-top-color:var(--action-green)}.secondary-story h3{margin:.55rem 0;font:900 1.25rem/1.08 var(--font-display)}.secondary-story h3 a{color:var(--navy-900);text-decoration:none}.secondary-story .summary{margin:.3rem 0;color:var(--slate-700);font-size:.86rem}.secondary-story .story-meta{margin-top:auto!important;border-color:#d4dde1;color:var(--slate-700)}.external-mark{color:var(--action-green)}.more-news{display:inline-flex;min-height:44px;align-items:center;margin-top:1rem;padding:.55rem .8rem;background:var(--navy-800);color:#fff;font-weight:900;text-decoration:none}.top-stories a:hover{text-decoration:underline;text-decoration-color:var(--action-green);text-decoration-thickness:3px;text-underline-offset:3px}@media(max-width:680px){.feed-heading{align-items:flex-start;flex-direction:column}.feed-heading>p{text-align:left}.lead-story{grid-template-columns:1fr;min-height:0}.lead-story img{min-height:180px;aspect-ratio:16/9}.secondary-stories{grid-template-columns:1fr}.summary{-webkit-line-clamp:3}}
</style>
<style>
  .top-stories{padding:0;border-top:0;background:transparent;box-shadow:none}.feed-heading{padding-bottom:1rem;border-bottom:1px solid var(--color-border)}.feed-heading h2{font-size:clamp(2rem,5vw,3.25rem)}.lead-story{position:relative;grid-template-columns:minmax(0,1.45fr) minmax(280px,.8fr);min-height:390px;border-radius:var(--card-radius);overflow:hidden}.story-media{min-width:0;aspect-ratio:16/9;background:var(--navy-800)}.story-media img{display:block;width:100%;height:100%;min-height:0;object-fit:contain}.story-media--graphic{position:relative;display:grid;place-items:center;overflow:hidden;background:linear-gradient(145deg,var(--navy-800),var(--pacific-blue,#176b91))}.story-media--graphic::before{content:"";position:absolute;inset:-20%;background:repeating-radial-gradient(ellipse at 20% 80%,transparent 0 24px,#ffffff24 25px 26px,transparent 27px 42px)}.story-media--graphic div{position:relative;display:grid;justify-items:center}.story-media--graphic strong{color:var(--action-green);font:900 7rem/.8 var(--font-display)}.story-media--graphic span{color:#fff;font-size:.7rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.lead-story h3{font-size:clamp(2rem,4.5vw,3.55rem)}.secondary-stories{grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin-top:1rem;background:transparent}.secondary-story{position:relative;display:grid;grid-template-columns:64px minmax(0,1fr);gap:1rem;padding:1.1rem;border:1px solid var(--color-border);border-top:1px solid var(--color-border);border-radius:var(--card-radius);background:var(--color-surface-elevated);box-shadow:none;transition:border-color .18s ease,background-color .18s ease}.secondary-story:hover{border-color:var(--navy-800);background:#f1f5f6}.secondary-story.external{border-top-color:var(--color-border)}.story-context{width:64px;height:64px;display:grid;place-items:center;background:linear-gradient(145deg,var(--navy-900),var(--navy-800));color:var(--action-green);font:900 1.35rem var(--font-display);text-transform:uppercase;clip-path:polygon(0 0,100% 0,88% 50%,100% 100%,0 100%,12% 50%)}.secondary-story__body{display:flex;min-width:0;flex-direction:column}.secondary-story h3 a::after{content:"";position:absolute;inset:0}.secondary-story h3 a:focus-visible{outline:0}.secondary-story:has(h3 a:focus-visible){outline:3px solid var(--navy-800);outline-offset:3px}.secondary-story .story-meta{line-height:1.5}.more-news{border-radius:var(--radius-sm)}
  .lead-story h3 a::after{content:"";position:absolute;inset:0}.lead-story h3 a:focus-visible{outline:0}.lead-story:has(h3 a:focus-visible){outline:3px solid var(--color-focus-ring);outline-offset:3px}
  .lead-story{grid-template-columns:minmax(0,1.45fr) minmax(260px,1fr);min-height:0}.story-media{height:100%;aspect-ratio:auto}.story-media img{object-fit:cover}
  @media(max-width:760px){.secondary-stories{grid-template-columns:1fr}}
  @media(max-width:680px){.lead-story{grid-template-columns:1fr;min-height:0}.story-media{height:auto;aspect-ratio:16/9}}
  @media(max-width:460px){.secondary-story{grid-template-columns:1fr}.story-context{width:48px;height:44px}.story-meta{font-size:.72rem}}
</style>
