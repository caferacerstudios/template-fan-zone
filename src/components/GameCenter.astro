---
import SeasonContextView from "./SeasonContext.astro";
import { formatKickoff } from "../lib/schedule.mjs";
import { formatPacificTime } from "../lib/season-context";
import Empty from "./game/EmptyState.astro";
import FormRow from "./game/FormRow.astro";
import LeaderList from "./game/LeaderList.astro";

const { game, context, options, previous, next, previousHref, nextHref, opponent, opponentAbbr, completed, outcome, weekLabel, seaScore, opponentScore, recapText, recapBullets, publishedAt, modifiedAt, readingMinutes, quarters, comparison, seaLeaders, seaSeasonLeaders, opponentLeaders, seaRecord, opponentRecord, seaForm, opponentForm, divisionContext, venue, links, turningPoints, sourceLabel, updatedAt } = Astro.props;
const home = String(game?.home_team?.abbreviation ?? "").toUpperCase() === "SEA";
const logo = (abbr) => `/images/nfl/teams/${abbr}.png`;
const name = opponent?.full_name ?? opponent?.fullName ?? opponent?.name ?? opponentAbbr;
const gameLabel = (row) => row?.postseason ? "Playoffs" : Number.isFinite(Number(row?.week)) ? `Week ${row.week}` : "Game";
const rowOpponent = (row) => String((String(row?.home_team?.abbreviation).toUpperCase() === "SEA" ? row?.visitor_team : row?.home_team)?.abbreviation ?? "").toUpperCase();
---

<SeasonContextView context={context} options={options} prefix="Data through" />
<article class:list={["game-scoreboard", completed && "is-final", outcome === "W" && "is-win", outcome === "L" && "is-loss", outcome === "T" && "is-tie"]}>
  <div class="topline"><span>{weekLabel}</span><span>{completed ? `Final${outcome ? ` · ${outcome}` : ""}` : "Matchup preview"}</span></div>
  <div class="teams">
    <div class="team"><img src={logo("SEA")} alt="Seattle {Team} logo" width="82" height="82" decoding="async" /><span>Seattle {Team}</span><strong>{completed ? seaScore ?? "—" : seaRecord}</strong><small>{home ? "Home" : "Away"}</small></div>
    <div class="versus">{completed ? "Final" : "vs"}</div>
    <div class="team opponent"><img src={logo(opponentAbbr)} alt={`${name} logo`} width="82" height="82" decoding="async" /><span>{name}</span><strong>{completed ? opponentScore ?? "—" : opponentRecord}</strong><small>{home ? "Away" : "Home"}</small></div>
  </div>
  <div class="details"><span>{formatKickoff(game)}</span>{venue && <span>{venue}</span>}<span>{home ? "Seattle home game" : "Seattle away game"}</span></div>
</article>

{completed && recapText && <div class="recap-meta" aria-label="Recap details">
  <span>By <strong>{Team} Fan Zone Editorial Team</strong></span>
  {publishedAt && <span>Published <time datetime={publishedAt}>{formatPacificTime(publishedAt)}</time></span>}
  {modifiedAt && publishedAt && new Date(modifiedAt).getTime() > new Date(publishedAt).getTime() && <span>Last updated <time datetime={modifiedAt}>{formatPacificTime(modifiedAt)}</time></span>}
  {readingMinutes && <span>{readingMinutes} min read</span>}
  <span>Category: Game Recaps</span>
</div>}

{!completed ? <div class="center-grid">
  <section class="panel"><h2>Matchup context</h2><dl><div><dt>Seattle record</dt><dd>{seaRecord}</dd></div><div><dt>{opponentAbbr} record</dt><dd>{opponentRecord}</dd></div></dl>{divisionContext ? <p>{divisionContext}</p> : <Empty title="NFC West context unavailable" text="Current division placement is not present in the available standings data." />}</section>
  <section class="panel"><h2>Recent form</h2>{seaForm.length && opponentForm.length ? <div class="form"><FormRow label="SEA" values={seaForm} /><FormRow label={opponentAbbr} values={opponentForm} /></div> : <Empty title="Recent form unavailable" text="Reliable prior results are not present for both teams." />}</section>
  <section class="panel"><h2>Season leaders</h2>{seaSeasonLeaders.length && opponentLeaders.length ? <div class="leader-columns"><LeaderList title="Seattle" rows={seaSeasonLeaders} /><LeaderList title={name} rows={opponentLeaders} /></div> : <Empty title="Opponent leaders unavailable" text="Season leaders are shown only when repository data exists for both teams." />}</section>
  <section class="panel"><h2>Watch and listen</h2>{links.length ? <ul class="plain-list">{links.map((link) => <li><a href={link.url}>{link.label} →</a></li>)}</ul> : <Empty title="Official links not posted" text="No maintained watch or listen links are attached to this game." />}</section>
</div> : <div class="center-grid">
  <section class="panel"><h2>Quarter by quarter</h2>{quarters.length ? <div class="table-wrap" role="region" aria-label="Quarter-by-quarter scores" tabindex="0"><table><caption class="visually-hidden">Quarter-by-quarter scoring for Seattle and {name}</caption><thead><tr><th scope="col">Team</th>{quarters.map((quarter) => <th scope="col">{quarter.label}</th>)}<th scope="col">Final</th></tr></thead><tbody><tr><th scope="row">SEA</th>{quarters.map((quarter) => <td>{home ? quarter.home ?? "—" : quarter.away ?? "—"}</td>)}<td>{seaScore}</td></tr><tr><th scope="row">{opponentAbbr}</th>{quarters.map((quarter) => <td>{home ? quarter.away ?? "—" : quarter.home ?? "—"}</td>)}<td>{opponentScore}</td></tr></tbody></table></div> : <Empty title="Quarter scores unavailable" text="The final score is available, but a quarter breakdown is not in the game data." />}</section>
  <section class="panel"><h2>The game in one paragraph</h2>{recapText ? <><p class="recap-copy">{recapText}</p>{recapBullets.length ? <ul>{recapBullets.map((bullet) => <li>{bullet}</li>)}</ul> : null}</> : <Empty title="Recap unavailable" text="No recap text is attached to this completed game." />}</section>
  <section class="panel"><h2>{Team} leaders</h2>{seaLeaders.length ? <LeaderList title="Offense and defense" rows={seaLeaders} /> : <Empty title="Game leaders unavailable" text="Per-game offensive and defensive player statistics were not included in the source data." />}</section>
  <section class="panel"><h2>Three key statistics</h2>{comparison.length ? <div class="table-wrap" role="region" aria-label="Team statistics comparison" tabindex="0"><table><caption class="visually-hidden">Key statistics for Seattle and {name}</caption><thead><tr><th scope="col">Statistic</th><th scope="col">SEA</th><th scope="col">{opponentAbbr}</th></tr></thead><tbody>{comparison.slice(0, 3).map((row) => <tr><th scope="row">{row.label}</th><td>{home ? row.home ?? "—" : row.away ?? "—"}</td><td>{home ? row.away ?? "—" : row.home ?? "—"}</td></tr>)}</tbody></table></div> : <Empty title="Key statistics unavailable" text="Side-by-side team statistics are not included for this game." />}</section>
  <section class="panel full"><h2>Turning points</h2>{turningPoints.length ? <ol class="events">{turningPoints.map((entry) => <li><strong>{entry?.clock ?? entry?.period ?? entry?.quarter ?? "Key moment"}</strong><span>{entry?.text ?? entry?.description ?? String(entry)}</span></li>)}</ol> : <Empty title="Turning points unavailable" text="No structured turning-point entries are attached to this game." />}</section>
  <section class="panel full"><h2>What comes next</h2>{next ? <p>Seattle’s next scheduled game is {gameLabel(next)} against {rowOpponent(next)}. <a href={nextHref}>Open the next game center →</a></p> : <p>This is the last game currently present in the schedule data. <a href="/schedule">View the full schedule →</a></p>}</section>
</div>}

{completed && recapText && <div class="share-actions" aria-label="Share this recap"><strong>Share recap</strong><button type="button" data-share data-analytics-event="share_action" data-analytics-share-method="native">Share</button><button type="button" data-copy data-analytics-event="share_action" data-analytics-share-method="copy_link">Copy link</button><span data-share-status aria-live="polite"></span></div>}

{completed && recapText && <aside class="recap-attribution" aria-label="About this recap"><strong>{Team} Fan Zone Editorial Team</strong><p>This house byline identifies work prepared and reviewed by the site’s individual owner and editor. {Team} Fan Zone is independent of the Seattle {Team} and NFL.</p><a href="/about">Editorial responsibility</a> · <a href="/contact#corrections">Request a correction</a></aside>}

<nav class="game-navigation" aria-label="Game navigation">
  {previous ? <a href={previousHref}><span>Previous game</span><strong>← {gameLabel(previous)} vs {rowOpponent(previous)}</strong></a> : <span class="nav-empty">First game on the schedule</span>}
  <a class="schedule" href="/schedule">Full schedule</a>
  {next ? <a class="next" href={nextHref} data-analytics-event="next_game_click" data-analytics-opponent={rowOpponent(next)}><span>Next game</span><strong>{gameLabel(next)} vs {rowOpponent(next)} →</strong></a> : <span class="nav-empty next">Last game on the schedule</span>}
</nav>
<p class="source-line"><strong>Source:</strong> {sourceLabel}. <strong>Updated:</strong> {formatPacificTime(updatedAt)}. <a href="/sources">Data notes</a></p>

<script is:inline>
  (() => {
    const share = document.querySelector('[data-share]'); const copy = document.querySelector('[data-copy]'); const status = document.querySelector('[data-share-status]');
    if (!share || !copy || !status) return;
    if (!navigator.share) share.hidden = true;
    share.addEventListener('click', async () => { try { await navigator.share({ title: document.title, url: document.querySelector('link[rel="canonical"]')?.href || location.href }); } catch (error) { if (error?.name !== 'AbortError') status.textContent = 'Sharing was unavailable.'; } });
    copy.addEventListener('click', async () => { try { await navigator.clipboard.writeText(document.querySelector('link[rel="canonical"]')?.href || location.href); status.textContent = 'Link copied.'; } catch { status.textContent = 'Copy the link from your address bar.'; } });
  })();
</script>

<style>
  .recap-meta{display:flex;flex-wrap:wrap;gap:.4rem 1.1rem;padding:.75rem 1rem;border:var(--border-crisp);border-top:0;background:#fff;color:var(--slate-700);font-size:.78rem}.share-actions{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap;margin-top:1rem;padding:.8rem;border:var(--border-crisp);background:#fff}.share-actions button{min-height:42px;padding:.45rem .8rem;border:2px solid var(--navy-800);background:#fff;color:var(--navy-900);font-weight:900;cursor:pointer}.share-actions [data-share]{background:var(--navy-800);color:#fff}.share-actions span{color:var(--slate-700);font-size:.8rem}.recap-attribution{margin-top:1rem;padding:1rem;border-top:5px solid var(--action-green);background:var(--navy-950);color:#fff}.recap-attribution p{margin:.35rem 0!important;color:var(--slate-100);line-height:1.55}.recap-attribution a{color:#fff;font-weight:900}
  .game-scoreboard{overflow:hidden;background:var(--navy-950);color:#fff;border-top:7px solid var(--action-green);box-shadow:var(--shadow-lg)}.game-scoreboard.is-loss{border-color:#a5acaf}.topline,.details{display:flex;justify-content:space-between;gap:.75rem 1.5rem;flex-wrap:wrap;padding:.75rem 1rem;background:#ffffff0d;color:var(--slate-300);font:800 .75rem var(--font-display);letter-spacing:.08em;text-transform:uppercase}.teams{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;padding:clamp(1.25rem,4vw,2.5rem)}.team{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:.25rem .75rem}.team img{grid-row:1/4;width:clamp(52px,8vw,82px);height:clamp(52px,8vw,82px);object-fit:contain}.team span{font-weight:900}.team strong{font:900 clamp(1.8rem,5vw,3.4rem) var(--font-display);font-variant-numeric:tabular-nums}.team small{color:var(--slate-300);text-transform:uppercase}.opponent{text-align:right;grid-template-columns:1fr auto}.opponent img{grid-column:2}.opponent span,.opponent strong,.opponent small{grid-column:1}.opponent span{grid-row:1}.opponent strong{grid-row:2}.opponent small{grid-row:3}.versus{color:var(--action-green);font-weight:900;text-transform:uppercase}.details{justify-content:flex-start;background:var(--navy-800);letter-spacing:0;text-transform:none}.center-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1rem}.panel{min-width:0;padding:1.1rem;border:var(--border-crisp);background:#fff}.panel h2{margin:0 0 .85rem;padding-left:.6rem;border-left:4px solid var(--action-green);font-size:1.05rem}.full{grid-column:1/-1}dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:0}dl div{padding:.65rem;background:var(--slate-100)}dt{color:var(--slate-700);font-size:.72rem;text-transform:uppercase}dd{margin:.2rem 0 0;font:900 1.4rem var(--font-display)}.form{display:grid;gap:.7rem}.leader-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.plain-list{margin:0;padding:0;list-style:none}.plain-list li+li{margin-top:.5rem}.plain-list a{font-weight:900}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}th,td{padding:.55rem;border-bottom:var(--border-crisp);text-align:center}th:first-child{text-align:left}.recap-copy{line-height:1.65}.events{margin:0;padding:0;list-style:none}.events li{display:grid;grid-template-columns:minmax(6rem,auto) 1fr;gap:.7rem;padding:.65rem 0;border-top:var(--border-crisp)}.game-navigation{display:grid;grid-template-columns:1fr auto 1fr;gap:.6rem;margin-top:1rem}.game-navigation>a,.nav-empty{display:grid;align-content:center;padding:.75rem;border:var(--border-crisp);background:#fff;text-decoration:none}.game-navigation a span{color:var(--slate-700);font-size:.68rem;text-transform:uppercase}.schedule{place-items:center;background:var(--navy-800)!important;color:#fff;font-weight:900}.next{text-align:right}.nav-empty{color:var(--slate-700);font-size:.8rem}.source-line{margin:1rem 0 0!important;color:var(--slate-700);font-size:.78rem}.source-line a{font-weight:900}@media(max-width:650px){.teams{grid-template-columns:1fr}.versus{text-align:center}.opponent{text-align:left;grid-template-columns:auto 1fr}.opponent img{grid-column:1;grid-row:1/4}.opponent span,.opponent strong,.opponent small{grid-column:2}.center-grid,.leader-columns{grid-template-columns:1fr}.full{grid-column:auto}.game-navigation{grid-template-columns:1fr 1fr}.schedule{grid-row:2;grid-column:1/-1}.events li{grid-template-columns:1fr}}
</style>

<style is:global>
  .empty-state{display:grid;gap:.25rem;padding:.85rem;border:1px solid #a5acaf66;background:var(--slate-100);color:var(--slate-700);font-size:.88rem}.empty-state strong{color:var(--navy-900)}.form-row{display:flex;align-items:center;gap:.4rem}.form-row>strong{width:3rem}.form-row>span{display:grid;width:1.8rem;height:1.8rem;place-items:center;border-radius:50%;background:var(--slate-300);font-weight:900}.form-row .result-w{background:var(--action-green)}.leader-list h3{margin:.1rem 0 .45rem;font-size:.9rem}.leader-list ul{margin:0;padding:0;list-style:none}.leader-list li{display:grid;grid-template-columns:1fr auto;gap:.1rem .5rem;padding:.55rem 0;border-top:var(--border-crisp)}.leader-list li span{grid-column:1/-1;color:var(--slate-700);font-size:.68rem;text-transform:uppercase}
</style>
