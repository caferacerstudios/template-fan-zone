---
import {Team}Layout from "../../../layouts/{Team}Layout.astro";
import { currentEdition, MIN_MEANINGFUL_ENTRIES } from "../../../data/around-the-web";

const entries = currentEdition.entries;
const hasEdition = entries.length >= MIN_MEANINGFUL_ENTRIES;
const topics = [...new Set(entries.map((entry) => entry.topic))];
const formatDate = (value: string) => new Intl.DateTimeFormat("en-US", {
  timeZone: "America/Los_Angeles", month: "short", day: "numeric", year: "numeric",
}).format(new Date(`${value}T12:00:00Z`));
const quickLinks = topics.map((topic) => ({ href: `#${topic.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`, label: topic }));
---

<{Team}Layout
  title="{Team} Around the Web | Curated Seattle Reading"
  description="A hand-curated {Team} reading digest with source attribution, original Seattle-focused commentary, and links to worthwhile reporting around the web."
  pageTitle="Around the Web"
  pageTagline="Worthwhile {Team} reporting, selected and explained by the {Team} Fan Zone editorial desk."
  activePath="/news/around-the-web"
  canonical="/news/around-the-web"
  pageType="article"
  articleCategory="curated-reading"
  monetizationEligible={false}
  {quickLinks}
  rightLinks={[
    { href: "/weekly-recap", label: "Latest SFZ recap" },
    { href: "/schedule", label: "Schedule & results" },
    { href: "/history", label: "History & The 12s" },
  ]}
>
  {hasEdition ? (
    <>
      <section class="edition-intro" aria-labelledby="edition-title">
        <div><p class="edition-label">Curated edition · {formatDate(currentEdition.publishedDate)}</p><h2 id="edition-title">{currentEdition.title}</h2></div>
        <p>{currentEdition.introduction}</p>
      </section>
      <p class="curation-note"><strong>How this works:</strong> SFZ editors choose each link and write every “Why this matters to Seattle” note. We link to publishers normally; we do not reproduce their stories, excerpts, or images. This edition carries no advertising.</p>
      {topics.map((topic) => {
        const topicEntries = entries.filter((entry) => entry.topic === topic);
        const topicId = topic.toLowerCase().replace(/[^a-z0-9]+/g, "-");
        return (
          <section class="topic-section" id={topicId} aria-labelledby={`${topicId}-title`}>
            <header class="topic-heading"><p>{String(topicEntries.length).padStart(2, "0")} selected reads</p><h2 id={`${topicId}-title`}>{topic}</h2></header>
            <div class="reading-list">
              {topicEntries.map((entry) => (
                <article class="source-card">
                  <div class="source-meta"><span class="publisher">{entry.publisher}</span>{entry.paywall && <span class="paywall">Paywall</span>}<time datetime={entry.publicationDate}>Published {formatDate(entry.publicationDate)}</time></div>
                  <h3><a href={entry.url} target="_blank" rel="noopener noreferrer">{entry.title}<span class="external-mark" aria-hidden="true">↗</span><span class="visually-hidden"> (opens publisher site in a new tab)</span></a></h3>
                  <div class="annotation"><p class="annotation-label">Why this matters to Seattle</p><p>{entry.whyItMatters}</p></div>
                  <footer><span>Added {formatDate(entry.dateAdded)}</span><span>Editor: {entry.editor}</span></footer>
                  {entry.relatedStories?.length > 0 && (
                    <nav class="related" aria-label={`Related {Team} Fan Zone stories for ${entry.title}`}>
                      <span>From SFZ</span>{entry.relatedStories?.map((story) => <a href={story.url} data-analytics-event="related_story_click" data-analytics-article-category="curated-reading">{story.title} →</a>)}
                    </nav>
                  )}
                </article>
              ))}
            </div>
          </section>
        );
      })}
    </>
  ) : (
    <section class="no-edition"><h2>No filler edition today</h2><p>We publish only when there are at least {MIN_MEANINGFUL_ENTRIES} worthwhile, distinct reads to recommend. Check back after the next meaningful {Team} news cycle.</p></section>
  )}

  <style>
    .edition-intro{display:grid;grid-template-columns:minmax(220px,.75fr) minmax(0,1.25fr);gap:2rem;padding:1.5rem;border-top:6px solid var(--action-green);background:var(--navy-900);color:#fff}.edition-label,.topic-heading p,.annotation-label{margin:0!important;color:var(--action-green);font:900 .7rem var(--font-display);letter-spacing:.11em;text-transform:uppercase}.edition-intro h2{margin:.3rem 0 0;color:#fff;font-size:clamp(2rem,5vw,3.5rem);line-height:.95}.edition-intro>p{margin:0;color:var(--slate-100);font-size:1.05rem;line-height:1.7}.curation-note{max-width:none!important;margin:1rem 0 0;padding:1rem 1.2rem;border-left:5px solid var(--action-green);background:#e4ecdf;color:var(--slate-700);font-size:.9rem}.topic-section{padding-top:2.75rem;scroll-margin-top:6.5rem}.topic-heading{margin-bottom:1rem;padding-left:.85rem;border-left:5px solid var(--action-green)}.topic-heading p{color:#4b711f}.topic-heading h2{margin:.15rem 0 0;font-size:clamp(1.8rem,4vw,2.8rem)}.reading-list{display:grid;gap:1rem}.source-card{padding:1.35rem;border:var(--border-crisp);border-top:5px solid var(--navy-800);background:#fff;box-shadow:var(--shadow-sm)}.source-meta{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem .75rem;color:var(--slate-700);font-size:.72rem;text-transform:uppercase}.publisher{padding:.25rem .45rem;background:var(--navy-900);color:#fff;font-weight:900;letter-spacing:.04em}.paywall{padding:.2rem .4rem;border:1px solid var(--warning);color:#704900;font-weight:900}.source-card h3{margin:.75rem 0;font-size:clamp(1.25rem,3vw,1.75rem);line-height:1.12}.source-card h3 a{color:var(--navy-900);text-decoration-color:var(--action-green)}.external-mark{display:inline-block;margin-left:.35rem;color:#4b711f;font-size:.85em}.annotation{padding:1rem;border-left:4px solid var(--action-green);background:var(--slate-100)}.annotation p:last-child{margin:.3rem 0 0;color:#263944;line-height:1.65}.annotation-label{color:#41651b}.source-card footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.5rem;margin-top:.9rem;color:var(--slate-700);font-size:.72rem}.related{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem 1rem;margin-top:.9rem;padding-top:.9rem;border-top:var(--border-crisp)}.related span{color:var(--navy-900);font:900 .7rem var(--font-display);letter-spacing:.09em;text-transform:uppercase}.related a{font-size:.8rem;font-weight:800}.no-edition{padding:1.5rem;border:1px dashed var(--slate-500);background:#fff}.visually-hidden{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}@media(max-width:680px){.edition-intro{grid-template-columns:1fr;gap:1rem;padding:1.15rem}.source-card{padding:1rem}.source-card footer{flex-direction:column}.related{align-items:flex-start;flex-direction:column}}
  </style>
</{Team}Layout>
